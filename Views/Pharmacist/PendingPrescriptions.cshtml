@model List<ibhayiPharmacy.Models.Prescription>

@{
    ViewData["Title"] = "Pending Prescriptions";
}

<div class="container-fluid mt-4">
    <div class="row mb-4">
        <div class="col-md-12">
            <h2><i class="fas fa-clock"></i> Pending Prescriptions</h2>
            <p class="text-muted">Process customer-uploaded prescriptions</p>
            <hr />
        </div>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="fas fa-check-circle"></i> @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="fas fa-exclamation-circle"></i> @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (Model == null || !Model.Any())
    {
        <div class="alert alert-info">
            <i class="fas fa-info-circle"></i> No pending prescriptions at the moment. All caught up!
        </div>
    }
    else
    {
        <div class="alert alert-warning mb-4">
            <i class="fas fa-exclamation-triangle"></i>
            <strong>@Model.Count</strong> prescription(s) waiting to be processed
        </div>

        <div class="table-responsive">
            <table class="table table-hover">
                <thead class="table-dark">
                    <tr>
                        <th>Reference</th>
                        <th>Patient Name</th>
                        <th>Upload Date</th>
                        <th>Wait Time</th>
                        <th>File</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var prescription in Model)
                    {
                        var waitTime = DateTime.Now - prescription.UploadDate;
                        var waitClass = waitTime.TotalHours > 24 ? "text-danger" :
                        waitTime.TotalHours > 12 ? "text-warning" :
                        "text-success";

                        <tr>
                            <td>
                                <strong>@($"RX{prescription.Id:D6}")</strong>
                            </td>

                            <td>
                                <i class="fas fa-user"></i> @prescription.PatientName
                                @if (!string.IsNullOrEmpty(prescription.PatientIDNumber))
                                {
                                    <br />
                                    <small class="text-muted">ID: @prescription.PatientIDNumber</small>
                                }
                            </td>

                            <td>
                                <small>
                                    @prescription.UploadDate.ToString("dd MMM yyyy")
                                    <br />@prescription.UploadDate.ToString("HH:mm")
                                </small>
                            </td>

                            <td class="@waitClass">
                                <strong>
                                    @if (waitTime.TotalDays >= 1)
                                    {
                                        @($"{(int)waitTime.TotalDays}d {waitTime.Hours}h")
                                    }
                                    else
                                    {
                                        @($"{waitTime.Hours}h {waitTime.Minutes}m")
                                    }
                                </strong>
                            </td>

                            <td>
                                @if (prescription.PrescriptionFileData != null)
                                {
                                    <span class="badge bg-success">
                                        <i class="fas fa-file-pdf"></i> PDF Available
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-danger">
                                        <i class="fas fa-times"></i> No File
                                    </span>
                                }
                            </td>

                            <td>
                                <div class="btn-group" role="group">
                                    <a asp-action="ProcessPrescription"
                                       asp-route-id="@prescription.Id"
                                       class="btn btn-sm btn-primary">
                                        <i class="fas fa-edit"></i> Process
                                    </a>

                                    @if (prescription.PrescriptionFileData != null)
                                    {
                                        <a asp-action="ViewPrescriptionPdf"
                                           asp-route-id="@prescription.Id"
                                           target="_blank"
                                           class="btn btn-sm btn-outline-secondary">
                                            <i class="fas fa-eye"></i> View PDF
                                        </a>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

<style>
    .table-hover tbody tr:hover {
        background-color: #f8f9fa;
        cursor: pointer;
    }
</style>
