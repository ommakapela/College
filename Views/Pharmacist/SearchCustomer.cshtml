@model IEnumerable<ibhayiPharmacy.Models.Customer>

@{
    ViewData["Title"] = "Search Customer";
}
<link href="https://fonts.googleapis.com/css2?family=Nunito:wght@400;700&display=swap" rel="stylesheet">
<style>
    body {
        font-family: 'Nunito', sans-serif;
        background: linear-gradient(to right, #f8fbff, #eaf2fb);
        margin: 0;
        padding: 40px 20px;
        color: #333;
    }

    h2 {
        text-align: center;
        color: #28a745;
        margin-bottom: 30px;
        font-weight: 700;
    }

    .form-section,
    .table-section {
        background: white;
        border-radius: 12px;
        padding: 25px;
        max-width: 1000px;
        margin: 20px auto;
        box-shadow: 0 6px 18px rgba(0, 0, 0, 0.06);
    }

    .drop-box {
        border: 2px dashed #007bff;
        padding: 30px;
        text-align: center;
        border-radius: 12px;
        background-color: #f0f8ff;
        font-weight: 600;
        color: #007bff;
        margin-bottom: 20px;
    }

    label {
        font-size: 15px;
        display: block;
        margin: 15px 0 10px;
        color: #333;
    }

    input[type="file"] {
        margin-top: 10px;
    }

    input[type="checkbox"] {
        margin-right: 5px;
    }

    .btn {
        padding: 8px 20px;
        border-radius: 6px;
        border: none;
        cursor: pointer;
        font-weight: 600;
        transition: all 0.3s ease;
    }

    .btn-order {
        background-color: #28a745;
        color: white;
    }

    .btn-edit {
        background-color: #ffc107;
        color: #fff;
    }

    .btn-remove {
        background-color: #dc3545;
        color: #fff;
    }

    .btn-view {
        background-color: #17a2b8;
        color: #fff;
    }

    .btn:hover {
        opacity: 0.9;
    }

    table {
        width: 100%;
        border-collapse: collapse;
        margin-top: 20px;
        background: white;
    }

    th, td {
        padding: 14px;
        border: 1px solid #dee2e6;
        text-align: center;
    }

    th {
        background-color: #007bff;
        color: white;
        font-weight: 600;
    }

    h3 {
        margin-top: 40px;
        color: #007bff;
        font-weight: 600;
        text-align: left;
    }

    .back-btn {
        display: flex;
        justify-content: center;
        margin-top: 30px;
    }

        .back-btn a {
            padding: 10px 25px;
            background-color: #6c757d;
            color: white;
            text-decoration: none;
            border-radius: 6px;
            transition: background-color 0.3s;
        }

            .back-btn a:hover {
                background-color: #495057;
            }
</style>


<form asp-controller="Pharmacist" asp-action="SearchCustomer" method="get">
    <input type="text" name="searchString" placeholder="Nolitha Ngwenya" @* value="@Request.Query["searchString"]" *@ />
    <input type="submit" value="Search" />
    <div class="table-section">
        <h3>Customer List</h3>
        <table>
            <thead>
                <tr>
                    <th>Customer Name</th>
                    <th>Action</th>

                </tr>
            </thead>
            <tbody>
                <tr>
                    <td>Nolitha Ngwenya</td>
                    <td><button class="btn btn-remove">View</button></td>


                    <a asp-controller="Pharmacist" asp-action="ViewCustomer" class="btn btn-primary">Existing Customer</a>
                    <a asp-controller="Pharmacist" asp-action="RegisterCustomer" class="btn btn-primary">New Customer</a>
                    @* <td><button class="btn btn-remove">Reject</button></td> *@
                </tr>
            </tbody>
        </table>


    </div>
    @* <div style="margin-bottom:20px;">
        <a asp-controller="Pharmacist" asp-action="ViewCustomer" class="btn btn-primary">Existing Customer</a>
        <a asp-controller="Pharmacist" asp-action="RegisterCustomer" class="btn btn-success">New Customer</a>
    </div> *@
</form>

