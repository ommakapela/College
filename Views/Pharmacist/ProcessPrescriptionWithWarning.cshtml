@model ibhayiPharmacy.Models.Prescription

@{
    ViewData["Title"] = "⚠️ ALLERGY WARNING - Process Prescription";
    var doctors = ViewBag.Doctors as List<ibhayiPharmacy.Models.Doctor>;
    var medications = ViewBag.Medications as List<ibhayiPharmacy.Models.Medication>;
    var customerName = ViewBag.CustomerName as string;
    var customerAllergies = ViewBag.CustomerAllergies as string;
    var hasAllergies = ViewBag.HasAllergies as bool?;
    var pdfData = ViewBag.PdfData as byte[];
}

<div class="container-fluid mt-4">
    <div class="row">
        <div class="col-12">
            <!-- Critical Allergy Warning Banner -->
            <div class="alert alert-danger border-danger" style="border-width: 3px; box-shadow: 0 4px 12px rgba(220, 53, 69, 0.3);">
                <div class="d-flex align-items-center mb-3">
                    <i class="fas fa-exclamation-triangle fa-3x text-danger me-3" style="animation: pulse 1.5s infinite;"></i>
                    <div>
                        <h3 class="mb-1 text-danger">
                            <i class="fas fa-shield-virus"></i> CRITICAL ALLERGY WARNING
                        </h3>
                        <p class="mb-0 fw-bold">Patient has known allergies to medications in this prescription!</p>
                    </div>
                </div>

                @if (TempData["AllergyWarning"] != null)
                {
                    <div class="bg-white p-3 rounded border border-danger">
                        @Html.Raw(TempData["AllergyWarning"])
                    </div>
                }

                <hr class="border-danger">

                <div class="bg-white p-3 rounded">
                    <h5 class="text-danger mb-2">
                        <i class="fas fa-user-injured"></i> Patient: @customerName
                    </h5>
                    <p class="mb-0">
                        <strong>Known Allergies:</strong>
                        <span class="badge bg-danger fs-6">@customerAllergies</span>
                    </p>
                </div>
            </div>

            <!-- Action Required Notice -->
            <div class="alert alert-warning mb-4">
                <h5><i class="fas fa-clipboard-check"></i> Pharmacist Action Required</h5>
                <p class="mb-2">You must:</p>
                <ul class="mb-0">
                    <li>Review the allergy warnings above carefully</li>
                    <li>Verify that dispensing these medications is safe and necessary</li>
                    <li>Consult with the prescribing doctor if needed</li>
                    <li>Document your decision to proceed</li>
                    <li>Check the acknowledgment box below to confirm you have reviewed the warnings</li>
                </ul>
            </div>
        </div>
    </div>

    <div class="row">
        <!-- Left Column: PDF Viewer -->
        <div class="col-md-6">
            <div class="card shadow-sm mb-4">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0"><i class="fas fa-file-pdf"></i> Original Prescription Document</h5>
                </div>
                <div class="card-body p-0">
                    @if (pdfData != null && pdfData.Length > 0)
                    {
                        var base64 = Convert.ToBase64String(pdfData);
                        <iframe src="data:application/pdf;base64,@base64"
                                style="width: 100%; height: 600px; border: none;">
                        </iframe>
                    }
                    else
                    {
                        <div class="p-4 text-center text-muted">
                            <i class="fas fa-file-pdf fa-3x mb-3"></i>
                            <p>No PDF available for this prescription</p>
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Right Column: Process Form -->
        <div class="col-md-6">
            <div class="card shadow-sm">
                <div class="card-header bg-danger text-white">
                    <h5 class="mb-0">
                        <i class="fas fa-pills"></i> Process Prescription RX@Model.Id.ToString("D6")
                    </h5>
                </div>
                <div class="card-body">
                    <form asp-action="AcknowledgeAllergyAndProcess" method="post" id="processForm">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@Model.Id" />

                        <!-- Patient Information -->
                        <div class="alert alert-info">
                            <h6><i class="fas fa-user"></i> Patient Information</h6>
                            <p class="mb-1"><strong>Name:</strong> @Model.PatientName</p>
                            @if (!string.IsNullOrEmpty(Model.PatientIDNumber))
                            {
                                <p class="mb-1"><strong>ID Number:</strong> @Model.PatientIDNumber</p>
                            }
                            <p class="mb-0"><strong>Upload Date:</strong> @Model.UploadDate.ToString("dd/MM/yyyy HH:mm")</p>
                        </div>

                        <!-- Prescription Details -->
                        <div class="mb-3">
                            <label class="form-label fw-bold">
                                <i class="fas fa-calendar-alt"></i> Prescription Date *
                            </label>
                            <input type="date" class="form-control" name="prescriptionDate"
                                   value="@DateTime.Now.ToString("yyyy-MM-dd")" required />
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-bold">
                                <i class="fas fa-user-md"></i> Prescribing Doctor *
                            </label>
                            <select class="form-select" name="doctorId" required>
                                <option value="">-- Select Doctor --</option>
                                @if (doctors != null)
                                {
                                    foreach (var doctor in doctors)
                                    {
                                        <option value="@doctor.Id">Dr. @doctor.Name @doctor.Surname - @doctor.PracticeNumber</option>
                                    }
                                }
                            </select>
                        </div>

                        <!-- Medications Section -->
                        <div class="mb-3">
                            <label class="form-label fw-bold">
                                <i class="fas fa-pills"></i> Medications *
                            </label>
                            <div id="medicationsContainer">
                                <div class="medication-item border p-3 mb-3 rounded bg-light">
                                    <div class="row g-2">
                                        <div class="col-12">
                                            <label class="form-label">Medication</label>
                                            <select class="form-select medication-select" name="medicationIds" required>
                                                <option value="">-- Select Medication --</option>
                                                @if (medications != null)
                                                {
                                                    foreach (var med in medications)
                                                    {
                                                        var ingredients = med.MedicationActiveIngredients != null
                                                        ? string.Join(", ", med.MedicationActiveIngredients
                                                        .Select(mai => mai.ActiveIngredient?.Name ?? "Unknown")
                                                        .Where(name => !string.IsNullOrEmpty(name)))
                                                        : "No ingredients listed";
                                                        <option value="@med.Id" data-ingredients="@ingredients">
                                                            @med.Name - Schedule @med.Schedule - R@med.Price.ToString("F2")
                                                        </option>
                                                    }
                                                }
                                            </select>
                                            <small class="text-muted ingredients-display"></small>
                                        </div>
                                        <div class="col-md-6">
                                            <label class="form-label">Quantity</label>
                                            <input type="number" class="form-control" name="quantities"
                                                   min="1" value="1" required />
                                        </div>
                                        <div class="col-md-6">
                                            <label class="form-label">Repeats</label>
                                            <input type="number" class="form-control" name="repeats"
                                                   min="0" max="6" value="0" required />
                                        </div>
                                        <div class="col-12">
                                            <label class="form-label">Instructions</label>
                                            <textarea class="form-control" name="instructions" rows="2"
                                                      placeholder="e.g., Take 1 tablet twice daily with food"></textarea>
                                        </div>
                                        <div class="col-12">
                                            <button type="button" class="btn btn-danger btn-sm remove-medication">
                                                <i class="fas fa-trash"></i> Remove
                                            </button>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <button type="button" class="btn btn-outline-primary" id="addMedication">
                                <i class="fas fa-plus"></i> Add Another Medication
                            </button>
                        </div>

                        <!-- Hidden unitPrices array (required by controller but not used in view) -->
                        <input type="hidden" name="unitPrices" value="0" class="unit-price-hidden" />

                        <!-- Allergy Acknowledgment -->
                        <div class="alert alert-danger border-danger" style="border-width: 2px;">
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" name="acknowledged"
                                       id="acknowledgeCheckbox" value="true" required
                                       style="width: 20px; height: 20px; cursor: pointer;">
                                <label class="form-check-label fw-bold ms-2" for="acknowledgeCheckbox"
                                       style="cursor: pointer; font-size: 1.1em;">
                                    <i class="fas fa-check-square"></i>
                                    I have reviewed the allergy warnings above and confirm that I am proceeding
                                    with this prescription after proper clinical consideration. I understand
                                    this decision will be logged.
                                </label>
                            </div>
                        </div>

                        <!-- Action Buttons -->
                        <div class="d-grid gap-2">
                            <button type="submit" class="btn btn-danger btn-lg" id="submitBtn" disabled>
                                <i class="fas fa-shield-virus"></i> Acknowledge Warning & Process Prescription
                            </button>
                            <a asp-action="PendingPrescriptions" class="btn btn-secondary">
                                <i class="fas fa-times"></i> Cancel - Do Not Process
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            // Enable/disable submit button based on checkbox
            $('#acknowledgeCheckbox').change(function() {
                $('#submitBtn').prop('disabled', !this.checked);
            });

            // Show ingredients when medication is selected
            $(document).on('change', '.medication-select', function() {
                var ingredients = $(this).find('option:selected').data('ingredients');
                $(this).siblings('.ingredients-display').text(
                    ingredients ? 'Active Ingredients: ' + ingredients : ''
                );
            });

            // Add new medication row
            $('#addMedication').click(function() {
                var template = $('.medication-item').first().clone();
                template.find('input, select, textarea').val('');
                template.find('.ingredients-display').text('');
                $('#medicationsContainer').append(template);

                // Add hidden unit price for new row
                var hiddenPrice = $('<input type="hidden" name="unitPrices" value="0" class="unit-price-hidden" />');
                template.append(hiddenPrice);
            });

            // Remove medication row
            $(document).on('click', '.remove-medication', function() {
                if ($('.medication-item').length > 1) {
                    $(this).closest('.medication-item').remove();
                } else {
                    alert('You must have at least one medication.');
                }
            });

            // Confirm before submitting
            $('#processForm').submit(function(e) {
                if (!confirm('⚠️ WARNING: You are about to process a prescription with ALLERGY CONFLICTS.\n\nAre you absolutely certain you want to proceed?')) {
                    e.preventDefault();
                    return false;
                }

                // Ensure we have the right number of hidden unit prices
                $('.unit-price-hidden').remove();
                $('.medication-item').each(function() {
                    $(this).append('<input type="hidden" name="unitPrices" value="0" class="unit-price-hidden" />');
                });
            });
        });
    </script>

    <style>
        @@keyframes pulse {
            0%, 100% {
                transform: scale(1);
            }

            50% {
                transform: scale(1.1);
            }
        }

        .medication-item {
            transition: all 0.3s ease;
        }

            .medication-item:hover {
                box-shadow: 0 2px 8px rgba(0,0,0,0.1);
            }

        #submitBtn:disabled {
            cursor: not-allowed;
            opacity: 0.6;
        }

        .form-check-input:checked {
            background-color: #dc3545;
            border-color: #dc3545;
        }

        .alert-danger {
            animation: fadeIn 0.5s ease-in;
        }

        @@keyframes fadeIn {
            from {
                opacity: 0;
                transform: translateY(-10px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }
    </style>
}