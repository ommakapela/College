@{
    ViewData["Title"] = "Appointments";
    // Layout = "~/Views/Shared/Pharmacy.cshtml";
}

<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link href="https://fonts.googleapis.com/css2?family=Nunito:wght@400;700&display=swap" rel="stylesheet">
    <style>
        body {
            font-family: 'Nunito', sans-serif;
            background: linear-gradient(to right, #f8fbff, #eaf2fb);
            margin: 0;
            padding: 40px 20px;
            color: #333;
        }

        h2 {
            text-align: center;
            color: #28a745;
            margin-bottom: 30px;
            font-weight: 700;
        }

        .form-section,
        .table-section {
            background: white;
            border-radius: 12px;
            padding: 25px;
            max-width: 1000px;
            margin: 20px auto;
            box-shadow: 0 6px 18px rgba(0, 0, 0, 0.06);
        }

        .drop-box {
            border: 2px dashed #007bff;
            padding: 30px;
            text-align: center;
            border-radius: 12px;
            background-color: #f0f8ff;
            font-weight: 600;
            color: #007bff;
            margin-bottom: 20px;
        }

        label {
            font-size: 15px;
            display: block;
            margin: 15px 0 10px;
            color: #333;
        }

        input[type="file"] {
            margin-top: 10px;
        }

        input[type="checkbox"] {
            margin-right: 5px;
        }

        .btn {
            padding: 8px 20px;
            border-radius: 6px;
            border: none;
            cursor: pointer;
            font-weight: 600;
            transition: all 0.3s ease;
        }

        .btn-order {
            background-color: #28a745;
            color: white;
        }

        .btn-edit {
            background-color: #ffc107;
            color: #fff;
        }

        .btn-remove {
            background-color: #dc3545;
            color: #fff;
        }

        .btn-view {
            background-color: #17a2b8;
            color: #fff;
        }

        .btn:hover {
            opacity: 0.9;
        }

        table {
            width: 100%;
            border-collapse: collapse;
            margin-top: 20px;
            background: white;
        }

        th, td {
            padding: 14px;
            border: 1px solid #dee2e6;
            text-align: center;
        }

        th {
            background-color: #007bff;
            color: white;
            font-weight: 600;
        }

        h3 {
            margin-top: 40px;
            color: #007bff;
            font-weight: 600;
            text-align: left;
        }

        .back-btn {
            display: flex;
            justify-content: center;
            margin-top: 30px;
        }

            .back-btn a {
                padding: 10px 25px;
                background-color: #6c757d;
                color: white;
                text-decoration: none;
                border-radius: 6px;
                transition: background-color 0.3s;
            }

                .back-btn a:hover {
                    background-color: #495057;
                }
    </style>
</head>

<body>

    <h2>Appointments</h2>
    <div class="table-section">
       
        <div class="back-btn">
            <a href="/Pharmacist/NewAppointment">← New Appointment</a>
        </div>
        <h3>Appointments/Pickups</h3>
        <table>
            <thead>
                <tr>
                    <th>Date</th>
                    <th>Customer Name</th>
                    <th>Customer Surname</th>
                    <th>Cell</th>
                    <th>Time</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td>2025-05-15</td>
                    <td>Luvuyo</td>
                    <td>Silo</td>
                    <td>078455236</td>
                    <td>11:00</td>
                </tr>
            </tbody>
        </table>
    </div>

    <div class="back-btn">
        <a href="/Pharmacist/Dashboard">← Back to Dashboard</a>
    </div>

</body>

</html>
