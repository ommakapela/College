@model ibhayiPharmacy.Models.Prescription

@{
    ViewData["Title"] = "Prescription Details";
}

<div class="container-fluid mt-4 mb-5">
    <!-- Back Button -->
    <div class="row mb-3">
        <div class="col-12">
            <a href="javascript:history.back()" class="btn btn-outline-success btn-lg">
                <i class="fas fa-arrow-left"></i> Go Back
            </a>
        </div>
    </div>

    <div class="row">
        <div class="col-12">
            <div class="card shadow-lg border-0">
                <div class="card-header bg-gradient-primary text-white text-center py-4">
                    <h1 class="display-4 mb-2">
                        <i class="fas fa-file-prescription"></i> Prescription Details
                    </h1>
                    <p class="lead mb-0">Prescription #@Model.Id</p>
                </div>
                <div class="card-body p-5">
                    @if (TempData["Success"] != null)
                    {
                        <div class="alert alert-success alert-dismissible fade show shadow-sm">
                            <i class="fas fa-check-circle"></i> <strong>Success!</strong> @TempData["Success"]
                            <button type="button" class="close" data-dismiss="alert">&times;</button>
                        </div>
                    }

                    @if (TempData["Error"] != null)
                    {
                        <div class="alert alert-danger alert-dismissible fade show shadow-sm">
                            <i class="fas fa-exclamation-circle"></i> <strong>Error!</strong> @TempData["Error"]
                            <button type="button" class="close" data-dismiss="alert">&times;</button>
                        </div>
                    }

                    <!-- Prescription Information -->
                    <div class="section-header mb-4">
                        <h3 class="text-primary">
                            <i class="fas fa-info-circle"></i> Prescription Information
                        </h3>
                        <hr class="section-line">
                    </div>

                    <div class="row mb-4">
                        <div class="col-md-6 mb-3">
                            <div class="info-card p-4 bg-light rounded shadow-sm">
                                <p class="mb-2">
                                    <strong><i class="fas fa-calendar-alt text-primary"></i> Prescription Date:</strong><br />
                                    <span class="text-dark">@Model.PrescriptionDate.ToString("dddd, dd MMMM yyyy")</span>
                                </p>
                            </div>
                        </div>
                        <div class="col-md-6 mb-3">
                            <div class="info-card p-4 bg-light rounded shadow-sm">
                                <p class="mb-2">
                                    <strong><i class="fas fa-user text-primary"></i> Patient Name:</strong><br />
                                    <span class="text-dark">@Model.PatientName</span>
                                </p>
                            </div>
                        </div>
                    </div>

                    @if (Model.Doctor != null)
                    {
                        <div class="row mb-4">
                            <div class="col-12">
                                <div class="info-card p-4 bg-light rounded shadow-sm">
                                    <h5 class="text-primary mb-3">
                                        <i class="fas fa-user-md"></i> Prescribing Doctor
                                    </h5>
                                    <div class="row">
                                        <div class="col-md-6 mb-2">
                                            <strong>Name:</strong> Dr. @Model.Doctor.Name @Model.Doctor.Surname
                                        </div>
                                        <div class="col-md-6 mb-2">
                                            <strong>Registration Number:</strong> @Model.Doctor.RegistrationNumber
                                        </div>
                                        @if (!string.IsNullOrEmpty(Model.Doctor.PracticeNumber))
                                        {
                                            <div class="col-md-6 mb-2">
                                                <strong>Practice Number:</strong> @Model.Doctor.PracticeNumber
                                            </div>
                                        }
                                        @if (!string.IsNullOrEmpty(Model.Doctor.Email))
                                        {
                                            <div class="col-md-6 mb-2">
                                                <strong>Email:</strong> <a href="mailto:@Model.Doctor.Email">@Model.Doctor.Email</a>
                                            </div>
                                        }
                                        @if (!string.IsNullOrEmpty(Model.Doctor.ContactNumber))
                                        {
                                            <div class="col-md-6 mb-2">
                                                <strong>Contact Number:</strong> <a href="tel:@Model.Doctor.ContactNumber">@Model.Doctor.ContactNumber</a>
                                            </div>
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>
                    }

                    <!-- Medications -->
                    <div class="section-header mb-4 mt-5">
                        <h3 class="text-primary">
                            <i class="fas fa-pills"></i> Prescribed Medications
                        </h3>
                        <hr class="section-line">
                    </div>

                    @if (Model.Items != null && Model.Items.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-hover table-bordered">
                                <thead class="thead-light">
                                    <tr>
                                        <th><i class="fas fa-capsules"></i> Medication</th>
                                        <th class="text-center"><i class="fas fa-sort-numeric-up"></i> Quantity</th>
                                        <th class="text-right"><i class="fas fa-tag"></i> Price/Unit</th>
                                        <th class="text-right"><i class="fas fa-calculator"></i> Subtotal</th>
                                        <th><i class="fas fa-notes-medical"></i> Instructions</th>
                                        <th class="text-center"><i class="fas fa-redo"></i> Repeats</th>
                                        <th class="text-center"><i class="fas fa-redo-alt"></i> Remaining</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @{
                                        decimal prescriptionSubtotal = 0;
                                    }
                                    @foreach (var item in Model.Items)
                                    {
                                        decimal itemTotal = (item.Medication?.Price ?? 0) * item.Quantity;
                                        prescriptionSubtotal += itemTotal;
                                        <tr>
                                            <td>
                                                <strong class="text-dark">@item.Medication?.Name</strong>
                                                @if (item.Medication != null)
                                                {
                                                    <br />
                                                    <small class="text-muted">
                                                        <i class="fas fa-pills"></i> @item.Medication.DosageForm
                                                        <br /><i class="fas fa-shield-alt"></i> Schedule @item.Medication.Schedule
                                                        @if (item.Medication.MedicationActiveIngredients != null && item.Medication.MedicationActiveIngredients.Any())
                                                        {
                                                            <br />
                                                            <strong class="text-info"><i class="fas fa-flask"></i> Active Ingredients:</strong>
                                                            <br />
                                                            @foreach (var mai in item.Medication.MedicationActiveIngredients)
                                                            {
                                                                <span class="badge badge-light mr-1 mb-1">
                                                                    @mai.ActiveIngredient.Name (@mai.Strength)
                                                                </span>
                                                            }
                                                        }
                                                    </small>
                                                }
                                            </td>
                                            <td class="text-center align-middle">
                                                <span class="badge badge-info badge-pill px-3 py-2" style="font-size: 1rem;">
                                                    @item.Quantity
                                                </span>
                                            </td>
                                            <td class="text-right align-middle">
                                                <strong>R @((item.Medication?.Price ?? 0).ToString("F2"))</strong>
                                            </td>
                                            <td class="text-right align-middle">
                                                <strong class="text-success">R @itemTotal.ToString("F2")</strong>
                                            </td>
                                            <td class="align-middle">
                                                @(item.Instructions ?? "No specific instructions")
                                            </td>
                                            <td class="text-center align-middle">
                                                <span class="badge badge-secondary badge-pill px-3 py-2" style="font-size: 1rem;">
                                                    @item.Repeats
                                                </span>
                                            </td>
                                            <td class="text-center align-middle">
                                                @if (item.Repeats > 0)
                                                {
                                                    <span class="badge badge-success badge-pill px-3 py-2" style="font-size: 1rem;">
                                                        @item.Repeats Available
                                                    </span>
                                                }
                                                else
                                                {
                                                    <span class="badge badge-danger badge-pill px-3 py-2" style="font-size: 1rem;">
                                                        None
                                                    </span>
                                                }
                                            </td>
                                        </tr>
                                    }
                                    @{
                                        decimal vat = prescriptionSubtotal * 0.15m;
                                        decimal total = prescriptionSubtotal + vat;
                                    }
                                    <tr class="table-secondary font-weight-bold">
                                        <td colspan="3" class="text-right">Subtotal:</td>
                                        <td class="text-right">R @prescriptionSubtotal.ToString("F2")</td>
                                        <td colspan="3"></td>
                                    </tr>
                                    <tr class="table-secondary font-weight-bold">
                                        <td colspan="3" class="text-right">VAT (15%):</td>
                                        <td class="text-right">R @vat.ToString("F2")</td>
                                        <td colspan="3"></td>
                                    </tr>
                                    <tr class="table-success font-weight-bold" style="font-size: 1.2rem;">
                                        <td colspan="3" class="text-right">
                                            <i class="fas fa-money-bill-wave"></i> TOTAL AMOUNT DUE:
                                        </td>
                                        <td class="text-right text-success">R @total.ToString("F2")</td>
                                        <td colspan="3"></td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="alert alert-info">
                            <i class="fas fa-info-circle"></i> No medications listed for this prescription.
                        </div>
                    }

                    <!-- Original Prescription Document -->
                    @if (Model.PrescriptionFileData != null && Model.PrescriptionFileData.Length > 0)
                    {
                        <div class="section-header mb-4 mt-5">
                            <h3 class="text-primary">
                                <i class="fas fa-file-pdf"></i> Original Prescription Document
                            </h3>
                            <hr class="section-line">
                        </div>

                        <div class="pdf-viewer-container mb-4">
                            <div class="alert alert-info mb-3">
                                <i class="fas fa-info-circle"></i> <strong>File:</strong> @(Model.FileName ?? "Prescription.pdf")
                            </div>
                            <div class="embed-responsive embed-responsive-16by9 border rounded shadow-sm">
                                <iframe class="embed-responsive-item"
                                        src="@Url.Action("DownloadPrescription", new { id = Model.Id })"
                                        type="application/pdf">
                                </iframe>
                            </div>
                        </div>
                    }

                    <!-- Action Buttons -->
                    <div class="row mt-5">
                        <div class="col-12 mb-4">
                            @{
                                decimal prescTotal = Model.Items.Sum(i => (i.Medication?.Price ?? 0) * i.Quantity);
                                decimal prescVat = prescTotal * 0.15m;
                                decimal prescGrandTotal = prescTotal + prescVat;
                            }
                            <div class="payment-summary-box p-4 bg-light border rounded shadow-sm">
                                <h4 class="text-primary mb-3">
                                    <i class="fas fa-wallet"></i> Payment Summary
                                </h4>
                                <div class="row">
                                    <div class="col-md-6">
                                        <p class="mb-2"><strong>Subtotal:</strong> <span class="float-right">R @prescTotal.ToString("F2")</span></p>
                                        <p class="mb-2"><strong>VAT (15%):</strong> <span class="float-right">R @prescVat.ToString("F2")</span></p>
                                        <hr class="my-2">
                                        <h5 class="text-success mb-0">
                                            <strong>Amount Due:</strong>
                                            <span class="float-right">R @prescGrandTotal.ToString("F2")</span>
                                        </h5>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="alert alert-warning mb-0">
                                            <i class="fas fa-info-circle"></i> <strong>Payment Information:</strong><br />
                                            Payment is due upon collection at Ibhayi Pharmacy.
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Action Buttons -->
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            @if (Model.PrescriptionFileData != null && Model.PrescriptionFileData.Length > 0)
                            {
                                <a href="@Url.Action("DownloadPrescription", new { id = Model.Id })"
                                   class="btn btn-primary btn-lg btn-block shadow">
                                    <i class="fas fa-download"></i> Download Prescription PDF
                                </a>
                            }
                        </div>
                        <div class="col-md-6 mb-3">
                            @if (Model.Items != null && Model.Items.Any(i => i.Repeats > 0))
                            {
                                <a href="@Url.Action("ManageRepeats", "Customer")"
                                   class="btn btn-success btn-lg btn-block shadow">
                                    <i class="fas fa-redo-alt"></i> Request Repeat
                                </a>
                            }
                        </div>
                    </div>

                    @if (User.IsInRole("Pharmacist"))
                    {
                        <div class="row mt-3">
                            <div class="col-12">
                                <form asp-action="DeletePrescription" method="post" onsubmit="return confirm('Are you sure you want to delete this prescription? This action cannot be undone.');">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@Model.Id" />
                                    <button type="submit" class="btn btn-danger btn-lg btn-block shadow">
                                        <i class="fas fa-trash-alt"></i> Delete Prescription
                                    </button>
                                </form>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .bg-gradient-primary {
        background: linear-gradient(135deg, #7bed9f 0%, #2ed573 100%);
    }

    .section-header h3 {
        font-size: 1.75rem;
        font-weight: 700;
        margin-bottom: 0.5rem;
    }

    .section-line {
        border-top: 3px solid #7bed9f;
        width: 100px;
        margin: 0.5rem 0 1rem 0;
    }

    .info-card {
        transition: all 0.3s ease;
        border: 1px solid rgba(123, 237, 159, 0.3);
    }

        .info-card:hover {
            transform: translateY(-3px);
            box-shadow: 0 5px 15px rgba(46, 213, 115, 0.2);
        }

    .table {
        font-size: 1.05rem;
    }

        .table thead th {
            font-weight: 600;
            border-bottom: 2px solid #7bed9f;
            color: #2ed573;
            background-color: #f0fdf4;
        }

        .table tbody tr {
            transition: background-color 0.2s ease;
        }

            .table tbody tr:hover {
                background-color: #f0fdf4;
            }

    .badge-pill {
        border-radius: 50rem;
    }

    .btn-primary {
        background: linear-gradient(135deg, #7bed9f 0%, #2ed573 100%);
        border: none;
        font-size: 1.2rem;
        font-weight: 600;
        transition: all 0.3s ease;
    }

        .btn-primary:hover {
            background: linear-gradient(135deg, #2ed573 0%, #1ea85a 100%);
            transform: translateY(-2px);
            box-shadow: 0 8px 20px rgba(46, 213, 115, 0.4);
        }

    .btn-success {
        background: linear-gradient(135deg, #7bed9f 0%, #2ed573 100%);
        border: none;
        font-size: 1.2rem;
        font-weight: 600;
        transition: all 0.3s ease;
    }

        .btn-success:hover {
            background: linear-gradient(135deg, #2ed573 0%, #1ea85a 100%);
            transform: translateY(-2px);
            box-shadow: 0 8px 20px rgba(46, 213, 115, 0.4);
        }

    .btn-danger {
        font-size: 1.2rem;
        font-weight: 600;
        transition: all 0.3s ease;
    }

        .btn-danger:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 20px rgba(220, 53, 69, 0.4);
        }

    .btn-outline-success {
        border: 2px solid #2ed573;
        color: #2ed573;
        font-weight: 600;
    }

        .btn-outline-success:hover {
            background: #2ed573;
            color: white;
        }

    .pdf-viewer-container iframe {
        min-height: 600px;
    }

    .card {
        border-radius: 15px;
        border: 2px solid rgba(123, 237, 159, 0.3);
    }

    .text-primary {
        color: #2ed573 !important;
    }

    .alert {
        font-size: 1.05rem;
        border-radius: 10px;
    }

    .payment-summary-box {
        border: 2px solid #7bed9f;
        background: linear-gradient(to right, #f0fdf4, #ffffff);
    }

        .payment-summary-box h5 {
            font-size: 1.4rem;
        }

    .badge-light {
        background-color: #f8f9fa;
        color: #495057;
        border: 1px solid #dee2e6;
    }

    @@media (max-width: 768px) {
        .pdf-viewer-container iframe {
            min-height: 400px;
        }

        .btn-lg {
            font-size: 1rem;
        }
    }
</style>