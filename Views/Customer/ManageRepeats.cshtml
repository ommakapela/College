@model IEnumerable<ibhayiPharmacy.Models.Prescription>

@{
    ViewData["Title"] = "Manage Repeats";
}

<div class="container-fluid mt-4 mb-5">
    <!-- Home Button -->
    <div class="row mb-3">
        <div class="col-12">
            <a href="@Url.Action("Dashboard")" class="btn btn-outline-success btn-lg">
                <i class="fas fa-home"></i> Back to Dashboard
            </a>
        </div>
    </div>

    <div class="row">
        <div class="col-12">
            <div class="card shadow-lg border-0">
                <div class="card-header bg-gradient-primary text-white text-center py-4">
                    <h1 class="display-4 mb-0">
                        <i class="fas fa-redo-alt"></i> Manage Prescription Repeats
                    </h1>
                    <p class="lead mb-0">Request repeats for your prescribed medications</p>
                </div>
                <div class="card-body p-5">
                    @if (TempData["Success"] != null)
                    {
                        <div class="alert alert-success alert-dismissible fade show shadow-sm">
                            <i class="fas fa-check-circle"></i> <strong>Success!</strong> @TempData["Success"]
                            <button type="button" class="close" data-dismiss="alert">&times;</button>
                        </div>
                    }

                    @if (TempData["Error"] != null)
                    {
                        <div class="alert alert-danger alert-dismissible fade show shadow-sm">
                            <i class="fas fa-exclamation-circle"></i> <strong>Error!</strong> @TempData["Error"]
                            <button type="button" class="close" data-dismiss="alert">&times;</button>
                        </div>
                    }

                    @if (Model != null && Model.Any())
                    {
                        <div class="alert alert-info mb-4">
                            <i class="fas fa-info-circle"></i> <strong>How it works:</strong> Select "Request Repeat" to order a refill. Each request reduces your remaining repeats by 1. A pharmacist will process your request.
                        </div>

                        @foreach (var prescription in Model)
                        {
                            <div class="prescription-card mb-4 border rounded shadow-sm">
                                <div class="card-header-custom bg-light-green p-4">
                                    <div class="row align-items-center">
                                        <div class="col-md-6">
                                            <h4 class="mb-0 text-primary">
                                                <i class="fas fa-file-prescription"></i> Prescription #@prescription.Id
                                            </h4>
                                            <small class="text-muted">
                                                <i class="fas fa-calendar"></i> @prescription.PrescriptionDate.ToString("dd MMMM yyyy")
                                            </small>
                                        </div>
                                        <div class="col-md-6 text-md-right">
                                            <div class="mb-2">
                                                <strong><i class="fas fa-user"></i> Patient:</strong> @prescription.PatientName
                                            </div>
                                            @if (prescription.Doctor != null)
                                            {
                                                <div>
                                                    <strong><i class="fas fa-user-md"></i> Doctor:</strong> Dr. @prescription.Doctor.Name @prescription.Doctor.Surname
                                                </div>
                                            }
                                        </div>
                                    </div>
                                </div>

                                <div class="card-body p-4">
                                    <h5 class="text-primary mb-3">
                                        <i class="fas fa-pills"></i> Medications with Available Repeats
                                    </h5>

                                    <div class="table-responsive">
                                        <table class="table table-hover">
                                            <thead class="thead-light">
                                                <tr>
                                                    <th><i class="fas fa-capsules"></i> Medication</th>
                                                    <th><i class="fas fa-sort-numeric-up"></i> Quantity</th>
                                                    <th><i class="fas fa-notes-medical"></i> Instructions</th>
                                                    <th class="text-center"><i class="fas fa-redo"></i> Repeats Left</th>
                                                    <th class="text-center"><i class="fas fa-cog"></i> Action</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @foreach (var item in prescription.Items.Where(i => i.Repeats > 0))
                                                {
                                                    <tr>
                                                        <td>
                                                            <strong class="text-dark">@item.Medication?.Name</strong>
                                                            @if (item.Medication != null)
                                                            {
                                                                <br />
                                                                <small class="text-muted">
                                                                    @item.Medication.DosageForm - Schedule @item.Medication.Schedule
                                                                </small>
                                                            }
                                                        </td>
                                                        <td class="align-middle">
                                                            <span class="badge badge-info badge-pill px-3 py-2">@item.Quantity units</span>
                                                        </td>
                                                        <td class="align-middle">
                                                            <small>@(item.Instructions ?? "No specific instructions")</small>
                                                        </td>
                                                        <td class="text-center align-middle">
                                                            <span class="badge badge-warning badge-lg px-4 py-2" style="font-size: 1.1rem;">
                                                                <i class="fas fa-redo-alt"></i> @item.Repeats
                                                            </span>
                                                        </td>
                                                        <td class="text-center align-middle">
                                                            @if (item.Repeats > 0)
                                                            {
                                                                <button type="button"
                                                                        class="btn btn-success btn-lg shadow-sm"
                                                                        onclick="requestRepeat(@prescription.Id, @item.Id, '@item.Medication?.Name', @item.Repeats)">
                                                                    <i class="fas fa-shopping-cart"></i> Request Repeat
                                                                </button>
                                                            }
                                                            else
                                                            {
                                                                <span class="badge badge-secondary badge-lg px-3 py-2">
                                                                    <i class="fas fa-ban"></i> No Repeats Left
                                                                </span>
                                                            }
                                                        </td>
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                    </div>

                                    <div class="mt-3 text-right">
                                        <a href="@Url.Action("ViewPrescriptionDetails", new { id = prescription.Id })"
                                           class="btn btn-outline-info btn-lg">
                                            <i class="fas fa-eye"></i> View Full Prescription
                                        </a>
                                    </div>
                                </div>
                            </div>
                        }
                    }
                    else
                    {
                        <div class="empty-state text-center py-5">
                            <div class="mb-4">
                                <i class="fas fa-inbox fa-5x text-muted"></i>
                            </div>
                            <h3 class="text-muted mb-3">No Repeats Available</h3>
                            <p class="lead text-muted mb-4">
                                You don't have any prescriptions with available repeats at this time.
                            </p>
                            <a href="@Url.Action("MyPrescriptions")" class="btn btn-primary btn-lg px-5">
                                <i class="fas fa-file-medical"></i> View All Prescriptions
                            </a>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Hidden Form for Repeat Request -->
<form id="requestRepeatForm" method="post" asp-action="RequestRepeat" style="display: none;">
    @Html.AntiForgeryToken()
    <input type="hidden" name="prescriptionId" id="repeatPrescriptionId" />
    <input type="hidden" name="itemId" id="repeatItemId" />
</form>

@section Scripts {
    <script>
        function requestRepeat(prescriptionId, itemId, medicationName, repeatsLeft) {
            const message = `Are you sure you want to request a repeat for:\n\n` +
                          `Medication: ${medicationName}\n` +
                          `Repeats remaining after this request: ${repeatsLeft - 1}\n\n` +
                          `A pharmacist will process your request.`;

            if (confirm(message)) {
                document.getElementById('repeatPrescriptionId').value = prescriptionId;
                document.getElementById('repeatItemId').value = itemId;
                document.getElementById('requestRepeatForm').submit();
            }
        }
    </script>
}

<style>
    .bg-gradient-primary {
        background: linear-gradient(135deg, #7bed9f 0%, #2ed573 100%);
    }

    .bg-light-green {
        background: linear-gradient(to right, #f0fdf4, #dcfce7);
        border-bottom: 3px solid #7bed9f;
    }

    .prescription-card {
        transition: all 0.3s ease;
        border: 2px solid rgba(123, 237, 159, 0.3);
    }

        .prescription-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 10px 25px rgba(46, 213, 115, 0.2) !important;
        }

    .table {
        font-size: 1.05rem;
    }

        .table thead th {
            font-weight: 600;
            border-bottom: 2px solid #7bed9f;
            color: #2ed573;
        }

    .btn-success {
        background: linear-gradient(135deg, #7bed9f 0%, #2ed573 100%);
        border: none;
        transition: all 0.3s ease;
    }

        .btn-success:hover {
            background: linear-gradient(135deg, #2ed573 0%, #1ea85a 100%);
            transform: translateY(-2px);
            box-shadow: 0 5px 15px rgba(46, 213, 115, 0.4);
        }

    .btn-outline-success {
        border: 2px solid #2ed573;
        color: #2ed573;
        font-weight: 600;
    }

        .btn-outline-success:hover {
            background: #2ed573;
            color: white;
        }

    .badge-warning {
        background: linear-gradient(135deg, #ffc107 0%, #ff9800 100%);
        color: #fff;
        font-weight: 600;
    }

    .badge-lg {
        font-size: 1rem;
        padding: 0.5rem 1rem;
    }

    .empty-state i {
        opacity: 0.3;
    }

    .alert {
        font-size: 1.05rem;
        border-radius: 10px;
    }

    .card {
        border-radius: 15px;
    }

    .text-primary {
        color: #2ed573 !important;
    }
</style>