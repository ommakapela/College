@model IEnumerable<ibhayiPharmacy.Models.Prescription>

@{
    ViewData["Title"] = "My Prescriptions";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Ibhayi Pharmacy</title>
    <link href="https://fonts.googleapis.com/css2?family=Nunito:wght@400;700&display=swap" rel="stylesheet">
    <!-- Font Awesome for Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <style>
        body {
            font-family: 'Nunito', sans-serif;
            background: linear-gradient(to right, #e6f7f1, #d9f0e6);
            margin: 0;
            padding: 0;
            color: #333;
        }

        .container {
            max-width: 1200px;
            margin: 40px auto;
            padding: 20px;
        }

        .title {
            text-align: center;
            color: #28a745;
            margin-bottom: 30px;
            font-size: 32px;
            font-weight: 700;
        }

        .alert {
            padding: 15px 20px;
            border-radius: 8px;
            margin-bottom: 20px;
        }

        .alert-success {
            background-color: #d4edda;
            color: #155724;
            border: 1px solid #c3e6cb;
        }

        .alert-danger {
            background-color: #f8d7da;
            color: #721c24;
            border: 1px solid #f5c6cb;
        }

        .btn {
            padding: 12px 25px;
            border: none;
            border-radius: 8px;
            font-weight: 700;
            cursor: pointer;
            transition: all 0.3s;
            font-family: 'Nunito', sans-serif;
            text-decoration: none;
            display: inline-block;
        }

        .btn-primary {
            background-color: #28a745;
            color: white;
        }

            .btn-primary:hover {
                background-color: #218838;
                transform: translateY(-2px);
            }

        .btn-secondary {
            background-color: #6c757d;
            color: white;
        }

        .btn-sm {
            padding: 8px 15px;
            font-size: 14px;
        }

        .prescription-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(350px, 1fr));
            gap: 25px;
            margin-bottom: 30px;
        }

        .prescription-card {
            background-color: #fff;
            border-radius: 16px;
            padding: 25px;
            box-shadow: 0 6px 15px rgba(40, 167, 69, 0.15);
            transition: transform 0.3s, box-shadow 0.3s;
        }

            .prescription-card:hover {
                transform: translateY(-8px);
                box-shadow: 0 10px 25px rgba(40, 167, 69, 0.25);
            }

        /* Status-based header colors */
        .prescription-header {
            color: white;
            padding: 12px 18px;
            border-radius: 10px;
            margin: -25px -25px 20px -25px;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .header-pending {
            background: linear-gradient(135deg, #ffc107 0%, #ff9800 100%);
        }

        .header-processed {
            background: linear-gradient(135deg, #17a2b8 0%, #138496 100%);
        }

        .header-dispensed {
            background: linear-gradient(135deg, #28a745 0%, #218838 100%);
        }

        .header-collected {
            background: linear-gradient(135deg, #6c757d 0%, #545b62 100%);
        }

        .header-default {
            background: linear-gradient(135deg, #28a745 0%, #218838 100%);
        }

        .prescription-badge {
            background-color: rgba(255,255,255,0.3);
            padding: 4px 12px;
            border-radius: 12px;
            font-size: 13px;
        }

        /* Status badge */
        .status-badge {
            display: inline-block;
            padding: 5px 12px;
            border-radius: 20px;
            font-size: 12px;
            font-weight: 700;
            margin-bottom: 12px;
        }

        .status-pending {
            background-color: #fff3cd;
            color: #856404;
        }

        .status-processed {
            background-color: #d1ecf1;
            color: #0c5460;
        }

        .status-dispensed {
            background-color: #d4edda;
            color: #155724;
        }

        .status-collected {
            background-color: #e2e3e5;
            color: #383d41;
        }

        .prescription-info {
            margin-bottom: 12px;
            color: #555;
            font-size: 15px;
        }

            .prescription-info strong {
                color: #28a745;
            }

        .medication-list {
            background-color: #f8f9fa;
            padding: 15px;
            border-radius: 8px;
            margin: 15px 0;
        }

            .medication-list ul {
                list-style: none;
                padding: 0;
                margin: 0;
            }

            .medication-list li {
                padding: 5px 0;
                color: #666;
            }

        .prescription-actions {
            display: flex;
            gap: 8px;
            margin-top: 15px;
            flex-wrap: wrap;
        }

        .btn-info {
            background-color: #17a2b8;
            color: white;
            flex: 1;
        }

        .btn-success {
            background-color: #28a745;
            color: white;
            flex: 1;
        }

        .btn-danger {
            background-color: #dc3545;
            color: white;
            flex: 1;
        }

        .back-link {
            text-align: center;
            margin-top: 30px;
        }

            .back-link a {
                color: #28a745;
                font-weight: 600;
                text-decoration: none;
            }

        .summary-card {
            background-color: #fff;
            border-radius: 16px;
            padding: 25px;
            box-shadow: 0 6px 15px rgba(40, 167, 69, 0.15);
            margin-bottom: 30px;
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: 20px;
            text-align: center;
        }

        .summary-item h3 {
            color: #28a745;
            font-size: 36px;
            margin: 0;
        }

        .summary-item p {
            color: #666;
            margin: 5px 0 0 0;
        }

        .empty-state {
            text-align: center;
            padding: 60px 20px;
            background-color: #fff;
            border-radius: 16px;
            box-shadow: 0 6px 15px rgba(40, 167, 69, 0.15);
        }

            .empty-state img {
                width: 120px;
                margin-bottom: 20px;
                opacity: 0.5;
            }

        /* Status indicator box */
        .status-indicator {
            padding: 10px 15px;
            border-radius: 8px;
            margin-bottom: 12px;
            font-size: 14px;
            display: flex;
            align-items: center;
            gap: 8px;
        }

            .status-indicator.warning {
                background-color: #fff3cd;
                color: #856404;
                border-left: 4px solid #ffc107;
            }

            .status-indicator.success {
                background-color: #d4edda;
                color: #155724;
                border-left: 4px solid #28a745;
            }

            .status-indicator.info {
                background-color: #d1ecf1;
                color: #0c5460;
                border-left: 4px solid #17a2b8;
            }
    </style>
</head>
<body>
    <div class="container">
        <h2 class="title">📋 My Prescriptions</h2>

        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success">
                <strong>Success!</strong> @TempData["Success"]
            </div>
        }

        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger">
                <strong>Error!</strong> @TempData["Error"]
            </div>
        }

        <div style="text-align: right; margin-bottom: 20px;">
            <a href="@Url.Action("UploadPrescription")" class="btn btn-primary">
                <i class="fas fa-upload"></i> Upload New Prescription
            </a>
        </div>

        @if (Model != null && Model.Any())
        {
            <!-- Summary -->
            <div class="summary-card">
                <div class="summary-item">
                    <h3>@Model.Count()</h3>
                    <p>Total Prescriptions</p>
                </div>
                <div class="summary-item">
                    <h3>@Model.Sum(p => p.Items.Count)</h3>
                    <p>Total Medications</p>
                </div>
                <div class="summary-item">
                    <h3>@Model.SelectMany(p => p.Items).Sum(i => i.Repeats)</h3>
                    <p>Total Repeats</p>
                </div>
                <div class="summary-item">
                    <h3>@Model.Count(p => p.PrescriptionFileData != null)</h3>
                    <p>PDFs Attached</p>
                </div>
            </div>

            <!-- Prescriptions Grid -->
            <div class="prescription-grid">
                @foreach (var prescription in Model)
                {
                    // Determine status class for header
                    var headerClass = prescription.Status switch
                    {
                        "Pending Processing" => "header-pending",
                        "Processed" => "header-processed",
                        "Dispensed" => "header-dispensed",
                        "Collected" => "header-collected",
                        _ => "header-default"
                    };

                    // Determine status badge class
                    var statusBadgeClass = prescription.Status switch
                    {
                        "Pending Processing" => "status-pending",
                        "Processed" => "status-processed",
                        "Dispensed" => "status-dispensed",
                        "Collected" => "status-collected",
                        _ => "status-pending"
                    };

                    // Determine status icon
                    var statusIcon = prescription.Status switch
                    {
                        "Pending Processing" => "fa-clock",
                        "Processed" => "fa-check-circle",
                        "Dispensed" => "fa-pills",
                        "Collected" => "fa-hand-holding-medical",
                        _ => "fa-file"
                    };

                    <div class="prescription-card">
                        <div class="prescription-header @headerClass">
                            <strong>
                                <i class="fas @statusIcon"></i> Prescription #@prescription.Id
                            </strong>
                            <span class="prescription-badge">
                                @prescription.UploadDate.ToString("dd MMM yyyy")
                            </span>
                        </div>

                        <!-- Status Badge -->
                        <div style="text-align: center;">
                            <span class="status-badge @statusBadgeClass">
                                <i class="fas @statusIcon"></i> @prescription.Status
                            </span>
                        </div>

                        <!-- Upload Date -->
                        <div class="prescription-info" style="font-size: 13px; color: #999;">
                            <i class="fas fa-calendar-upload"></i> Uploaded: @prescription.UploadDate.ToString("dd MMM yyyy HH:mm")
                        </div>

                        <!-- Patient Info -->
                        <div class="prescription-info">
                            <strong><i class="fas fa-user"></i> Patient:</strong> @prescription.PatientName
                        </div>

                        <!-- Doctor Info (only if processed) -->
                        @if (prescription.Status != "Pending Processing")
                        {
                            <div class="prescription-info">
                                <strong><i class="fas fa-user-md"></i> Doctor:</strong>
                                @if (prescription.Doctor != null)
                                {
                                    <span>Dr. @prescription.Doctor.Name @prescription.Doctor.Surname</span>
                                }
                                else
                                {
                                    <span style="color: #999;">N/A</span>
                                }
                            </div>

                            <div class="prescription-info">
                                <strong><i class="fas fa-calendar-check"></i> Prescription Date:</strong>
                                @prescription.PrescriptionDate.ToString("dd MMM yyyy")
                            </div>

                            <!-- Medications List -->
                            <div class="medication-list">
                                <strong style="color: #28a745;">
                                    <i class="fas fa-pills"></i> Medications (@prescription.Items.Count)
                                </strong>
                                <ul>
                                    @foreach (var item in prescription.Items.Take(3))
                                    {
                                        <li>
                                            • @item.Medication.Name - Qty: @item.Quantity
                                            @if (item.Repeats > 0)
                                            {
                                                <span style="background-color: #fff3cd; padding: 2px 8px; border-radius: 4px; font-size: 12px;">
                                                    🔄 @item.Repeats repeats
                                                </span>
                                            }
                                        </li>
                                    }
                                    @if (prescription.Items.Count > 3)
                                    {
                                        <li style="color: #999;">... +@(prescription.Items.Count - 3) more</li>
                                    }
                                </ul>
                            </div>

                            <!-- Dispensed Status -->
                            @if (prescription.IsDispensed)
                            {
                                <div class="prescription-info" style="color: #28a745;">
                                    <strong><i class="fas fa-check-circle"></i> Dispensed:</strong>
                                    @prescription.DispensedDate?.ToString("dd MMM yyyy")
                                </div>
                            }

                            <!-- Collection Status -->
                            @if (prescription.ReadyForCollection && !prescription.IsCollected)
                            {
                                <div class="status-indicator success">
                                    <i class="fas fa-gift"></i>
                                    <strong>Ready for Collection!</strong>
                                </div>
                            }

                            @if (prescription.IsCollected)
                            {
                                <div class="prescription-info" style="color: #6c757d;">
                                    <i class="fas fa-check-double"></i>
                                    Collected: @prescription.CollectionDate?.ToString("dd MMM yyyy")
                                </div>
                            }
                        }
                        else
                        {
                            <!-- Pending Status Message -->
                            <div class="status-indicator warning">
                                <i class="fas fa-hourglass-half"></i>
                                <strong>Waiting for pharmacist to process...</strong>
                            </div>
                        }

                        <!-- PDF Attached Indicator -->
                        @if (prescription.PrescriptionFileData != null && prescription.PrescriptionFileData.Length > 0)
                        {
                            <div style="text-align: center; padding: 8px; background-color: #d4edda; border-radius: 6px; color: #155724; margin-bottom: 10px;">
                                <i class="fas fa-file-pdf"></i> ✓ PDF Attached
                            </div>
                        }

                        <!-- Action Buttons -->
                        <div class="prescription-actions">
                            <a href="@Url.Action("ViewPrescriptionDetails", new { id = prescription.Id })"
                               class="btn btn-info btn-sm">
                                <i class="fas fa-eye"></i> View
                            </a>

                            @if (prescription.PrescriptionFileData != null && prescription.PrescriptionFileData.Length > 0)
                            {
                                <a href="@Url.Action("DownloadPrescription", new { id = prescription.Id })"
                                   class="btn btn-success btn-sm">
                                    <i class="fas fa-download"></i> PDF
                                </a>
                            }

                            <button type="button" class="btn btn-danger btn-sm"
                                    onclick="confirmDelete(@prescription.Id)">
                                <i class="fas fa-trash"></i> Delete
                            </button>
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="empty-state">
                <div style="font-size: 80px; margin-bottom: 20px;">📋</div>
                <h3 style="color: #28a745;">No Prescriptions Found</h3>
                <p style="color: #666; margin-bottom: 20px;">You haven't uploaded any prescriptions yet.</p>
                <a href="@Url.Action("UploadPrescription")" class="btn btn-primary">
                    <i class="fas fa-plus"></i> Upload Your First Prescription
                </a>
            </div>
        }

        <div class="back-link">
            <a href="@Url.Action("Dashboard")">
                <i class="fas fa-arrow-left"></i> Back to Dashboard
            </a>
        </div>
    </div>

    <!-- Delete Modal -->
    <div id="deleteModal" style="display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%; background-color: rgba(0,0,0,0.5); z-index: 1000; align-items: center; justify-content: center;">
        <div style="background-color: white; border-radius: 16px; padding: 30px; max-width: 400px; text-align: center;">
            <h3 style="color: #dc3545; margin-bottom: 15px;">⚠️ Confirm Delete</h3>
            <p style="margin-bottom: 25px;">Are you sure you want to delete this prescription?<br><strong>This action cannot be undone.</strong></p>
            <form id="deleteForm" method="post" style="display: inline;">
                @Html.AntiForgeryToken()
                <button type="button" onclick="closeModal()" class="btn btn-secondary btn-sm">Cancel</button>
                <button type="submit" class="btn btn-danger btn-sm">Delete</button>
            </form>
        </div>
    </div>

    <script>
        function confirmDelete(prescriptionId) {
            const form = document.getElementById('deleteForm');
            form.action = '@Url.Action("DeletePrescription")' + '?id=' + prescriptionId;
            document.getElementById('deleteModal').style.display = 'flex';
        }

        function closeModal() {
            document.getElementById('deleteModal').style.display = 'none';
        }

        // Close modal when clicking outside
        document.getElementById('deleteModal')?.addEventListener('click', function(e) {
            if (e.target === this) {
                closeModal();
            }
        });
    </script>
</body>
</html>