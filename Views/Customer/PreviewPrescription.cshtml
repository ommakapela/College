@{
    ViewData["Title"] = "Prescription Details";
    Layout = null;
    var customer = ViewBag.CurrentCustomer;
    var pdfFileName = ViewBag.PdfFileName as string;
    var pdfData = ViewBag.PdfData as byte[];
    var pdfBase64 = pdfData != null ? Convert.ToBase64String(pdfData) : "";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <title>@ViewData["Title"] - Ibhayi Pharmacy</title>
    <link href="https://fonts.googleapis.com/css2?family=Nunito:wght@400;700&display=swap" rel="stylesheet">
    <style>
        body {
            font-family: 'Nunito', sans-serif;
            background: linear-gradient(to right, #e6f7f1, #d9f0e6);
            margin: 0;
            padding: 0;
            color: #333;
        }

        .container {
            max-width: 900px;
            margin: 40px auto;
            padding: 20px;
        }

        .title {
            text-align: center;
            color: #28a745;
            margin-bottom: 30px;
            font-size: 32px;
            font-weight: 700;
        }

        .card {
            background-color: #fff;
            border-radius: 16px;
            padding: 30px;
            box-shadow: 0 6px 15px rgba(40, 167, 69, 0.15);
            margin-bottom: 20px;
        }

        .card-header {
            background-color: #28a745;
            color: white;
            padding: 15px 20px;
            border-radius: 12px 12px 0 0;
            margin: -30px -30px 20px -30px;
            font-size: 20px;
            font-weight: 700;
        }

        .form-group {
            margin-bottom: 20px;
        }

        label {
            font-weight: 600;
            color: #28a745;
            display: block;
            margin-bottom: 8px;
        }

        input[type="text"], input[type="email"], input[type="password"], input[type="number"], input[type="date"], select, textarea {
            width: 100%;
            padding: 12px;
            border: 2px solid #d9f0e6;
            border-radius: 8px;
            font-family: 'Nunito', sans-serif;
            font-size: 15px;
            transition: border-color 0.3s;
        }

            input:focus, select:focus, textarea:focus {
                outline: none;
                border-color: #28a745;
            }

        .btn {
            padding: 12px 30px;
            border: none;
            border-radius: 8px;
            font-weight: 700;
            cursor: pointer;
            transition: all 0.3s;
            font-family: 'Nunito', sans-serif;
            font-size: 16px;
        }

        .btn-primary {
            background-color: #28a745;
            color: white;
        }

            .btn-primary:hover {
                background-color: #218838;
                transform: translateY(-2px);
                box-shadow: 0 4px 12px rgba(40, 167, 69, 0.3);
            }

        .btn-secondary {
            background-color: #6c757d;
            color: white;
        }

            .btn-secondary:hover {
                background-color: #5a6268;
            }

        .text-danger {
            color: #dc3545;
            font-size: 13px;
        }

        .alert {
            padding: 15px 20px;
            border-radius: 8px;
            margin-bottom: 20px;
        }

        .alert-success {
            background-color: #d4edda;
            color: #155724;
            border: 1px solid #c3e6cb;
        }

        .alert-danger {
            background-color: #f8d7da;
            color: #721c24;
            border: 1px solid #f5c6cb;
        }

        .row {
            display: flex;
            gap: 15px;
            flex-wrap: wrap;
        }

        .col-md-6 {
            flex: 1;
            min-width: 250px;
        }

        .d-flex {
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .medication-row {
            background-color: #f8f9fa;
            padding: 20px;
            border-radius: 12px;
            margin-bottom: 15px;
            border: 2px solid #e6f7f1;
        }

            .medication-row:hover {
                border-color: #28a745;
            }

        .back-link {
            text-align: center;
            margin-top: 30px;
        }

            .back-link a {
                color: #28a745;
                font-weight: 600;
                text-decoration: none;
            }

                .back-link a:hover {
                    color: #218838;
                }

        small {
            color: #666;
            font-size: 13px;
        }
    </style>
</head>
<body>
    <div class="container">
        <h2 class="title">📝 Enter Prescription Details</h2>

        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger">
                <strong>Error!</strong> @TempData["Error"]
            </div>
        }
        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success">
                <strong>Success!</strong> @TempData["Success"]
            </div>
        }

        <!-- PDF Preview Section -->
        <div class="card">
            <div class="card-header">📄 Prescription PDF Preview</div>
            <div class="form-group">
                @if (!string.IsNullOrEmpty(pdfBase64))
                {
                    <embed src="data:application/pdf;base64,@pdfBase64" type="application/pdf" width="100%" height="500px" />
                    <div style="margin-top:10px;">
                        <a href="data:application/pdf;base64,@pdfBase64" download="@pdfFileName" class="btn btn-primary">Download PDF</a>
                    </div>
                }
                else
                {
                    <span class="text-danger">PDF preview not available.</span>
                }
            </div>
        </div>

        <form asp-action="SavePrescription" method="post" id="detailsForm">
            @Html.AntiForgeryToken()

            <!-- Customer Details (Auto-filled, Read-only) -->
            <div class="card">
                <div class="card-header">👤 Your Details</div>
                <div class="row">
                    <div class="col-md-6">
                        <div class="form-group">
                            <label for="customerName">Full Name</label>
                            <input type="text" id="customerName" name="customerName" value="@customer?.FullName" readonly />
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-group">
                            <label for="customerIdNumber">ID Number</label>
                            <input type="text" id="customerIdNumber" name="customerIdNumber" value="@customer?.IdNumber" readonly />
                        </div>
                    </div>
                </div>
                <div class="row">
                    <div class="col-md-6">
                        <div class="form-group">
                            <label for="customerCellphone">Cellphone</label>
                            <input type="text" id="customerCellphone" name="customerCellphone" value="@customer?.Cellphone" readonly />
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-group">
                            <label for="customerAllergies">Allergies</label>
                            <input type="text" id="customerAllergies" name="customerAllergies" value="@customer?.Allergies" readonly />
                        </div>
                    </div>
                </div>
            </div>

            <!-- Patient Details (Auto-filled, Read-only) -->
            <div class="card">
                <div class="card-header">👤 Patient Details</div>
                <div class="row">
                    <div class="col-md-6">
                        <div class="form-group">
                            <label for="patientName">Patient Name <span class="text-danger">*</span></label>
                            <input type="text" id="patientName" name="patientName" value="@customer?.FullName" readonly />
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-group">
                            <label for="patientIdNumber">Patient ID Number</label>
                            <input type="text" id="patientIdNumber" name="patientIdNumber" value="@customer?.IdNumber" readonly />
                        </div>
                    </div>
                </div>
                <div class="row">
                    <div class="col-md-6">
                        <div class="form-group">
                            <label for="patientCellphone">Patient Cellphone</label>
                            <input type="text" id="patientCellphone" name="patientCellphone" value="@customer?.Cellphone" readonly />
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-group">
                            <label for="patientAllergies">Patient Allergies</label>
                            <input type="text" id="patientAllergies" name="patientAllergies" value="@customer?.Allergies" readonly />
                        </div>
                    </div>
                </div>
            </div>

            <!-- Prescription Details -->
            <div class="card">
                <div class="card-header">📝 Prescription Details</div>
                <div class="form-group">
                    <label for="prescriptionDate">Prescription Date <span class="text-danger">*</span></label>
                    <input type="date" id="prescriptionDate" name="prescriptionDate"
                           value="@DateTime.Now.ToString("yyyy-MM-dd")" required />
                </div>
                <div class="form-group">
                    <label for="doctorId">Doctor <span class="text-danger">*</span></label>
                    <select id="doctorId" name="doctorId" required>
                        <option value="">-- Select Doctor --</option>
                        @foreach (var doctor in ViewBag.Doctors)
                        {
                            <option value="@doctor.Id">Dr. @doctor.Name @doctor.Surname</option>
                        }
                    </select>
                </div>
            </div>

            <!-- Medications (unchanged) -->
            <div class="card">
                <div class="card-header">
                    <div class="d-flex">
                        <span>💊 Medications</span>
                        <button type="button" class="btn btn-success" onclick="addMedicationRow()" style="padding: 6px 15px; font-size: 14px;">
                            + Add Medication
                        </button>
                    </div>
                </div>
                <div id="medicationsContainer">
                    <!-- Medication rows added via JavaScript -->
                </div>
            </div>

            <!-- Action Buttons -->
            <div class="d-flex" style="margin-top: 30px;">
                <a href="@Url.Action("UploadPrescription")" class="btn btn-secondary">← Cancel</a>
                <button type="submit" class="btn btn-primary">💾 Save Prescription</button>
            </div>
        </form>

        <div class="back-link">
            <a href="@Url.Action("Dashboard")">← Back to Dashboard</a>
        </div>
    </div>

    <script>
        let medicationCounter = 0;
        const medicationOptions = `@@Html.Raw(string.Join("", ViewBag.Medications.Select(m => $"<option value='{m.Id}'>{m.Name}</option>")))`;

        window.onload = function() {
            addMedicationRow();
        };

        function addMedicationRow() {
            const container = document.getElementById('medicationsContainer');
            const rowId = medicationCounter++;

            const row = document.createElement('div');
            row.className = 'medication-row';
            row.id = `medRow${rowId}`;
            row.innerHTML = `
        <div class="d-flex" style="margin-bottom: 15px;">
            <strong style="color: #28a745;">💊 Medication #${rowId + 1}</strong>
            <button type="button" class="btn btn-danger" onclick="removeMedicationRow(${rowId})">
                🗑️ Remove
            </button>
        </div>
        <div class="form-group">
            <label>Medication <span class="text-danger">*</span></label>
            <select name="medicationIds" required>
                <option value="">-- Select Medication --</option>
                ${medicationOptions}
            </select>
        </div>
        <div class="row">
            <div class="col-md-6">
                <div class="form-group">
                    <label>Quantity <span class="text-danger">*</span></label>
                    <input type="number" name="quantities" min="1" value="1" required />
                </div>
            </div>
            <div class="col-md-6">
                <div class="form-group">
                    <label>Repeats</label>
                    <input type="number" name="repeats" min="0" value="0" />
                </div>
            </div>
        </div>
        <div class="form-group">
            <label>Instructions</label>
            <textarea name="instructions" rows="2" placeholder="e.g., Take 2 tablets daily with food"></textarea>
        </div>
        `;
            container.appendChild(row);
        }

        function removeMedicationRow(rowId) {
            const row = document.getElementById(`medRow${rowId}`);
            if (row) {
                row.remove();
            }
            const remaining = document.querySelectorAll('.medication-row').length;
            if (remaining === 0) {
                addMedicationRow();
            }
            updateMedicationNumbers();
        }

        function updateMedicationNumbers() {
            const rows = document.querySelectorAll('.medication-row');
            rows.forEach((row, index) => {
                const header = row.querySelector('strong');
                if (header) {
                    header.textContent = `💊 Medication #${index + 1}`;
                }
            });
        }

        document.getElementById('detailsForm').addEventListener('submit', function(e) {
            const medicationRows = document.querySelectorAll('.medication-row').length;
            if (medicationRows === 0) {
                e.preventDefault();
                alert('Please add at least one medication.');
                return false;
            }
        });
    </script>
</body>
</html>