@model IEnumerable<ibhayiPharmacy.Models.Prescription>

@{
    ViewData["Title"] = "My Orders";
}

<div class="container-fluid mt-4 mb-5">
    <!-- Back Button -->
    <div class="row mb-3">
        <div class="col-12">
            <a href="@Url.Action("Dashboard")" class="btn btn-outline-success btn-lg">
                <i class="fas fa-home"></i> Back to Dashboard
            </a>
        </div>
    </div>

    <div class="row">
        <div class="col-12">
            <div class="card shadow-lg border-0">
                <div class="card-header bg-gradient-primary text-white text-center py-4">
                    <h1 class="display-4 mb-2">
                        <i class="fas fa-shopping-cart"></i> My Prescription Orders
                    </h1>
                    <p class="lead mb-0">View and track your prescription orders</p>
                </div>
                <div class="card-body p-5">
                    @if (TempData["Success"] != null)
                    {
                        <div class="alert alert-success alert-dismissible fade show shadow-sm">
                            <i class="fas fa-check-circle"></i> <strong>Success!</strong> @TempData["Success"]
                            <button type="button" class="close" data-dismiss="alert">&times;</button>
                        </div>
                    }

                    @if (TempData["Error"] != null)
                    {
                        <div class="alert alert-danger alert-dismissible fade show shadow-sm">
                            <i class="fas fa-exclamation-circle"></i> <strong>Error!</strong> @TempData["Error"]
                            <button type="button" class="close" data-dismiss="alert">&times;</button>
                        </div>
                    }

                    @if (Model != null && Model.Any())
                    {
                        <div class="alert alert-info mb-4">
                            <i class="fas fa-info-circle"></i> <strong>Total Orders:</strong> @Model.Count() prescription(s) found
                        </div>

                        <!-- Summary Cards -->
                        <div class="row mb-4">
                            <div class="col-md-3 mb-3">
                                <div class="stat-card text-center p-4 bg-light rounded shadow-sm">
                                    <div class="stat-icon mb-2">
                                        <i class="fas fa-file-prescription fa-3x text-primary"></i>
                                    </div>
                                    <h3 class="mb-0">@Model.Count()</h3>
                                    <p class="text-muted mb-0">Total Prescriptions</p>
                                </div>
                            </div>
                            <div class="col-md-3 mb-3">
                                <div class="stat-card text-center p-4 bg-light rounded shadow-sm">
                                    <div class="stat-icon mb-2">
                                        <i class="fas fa-pills fa-3x text-success"></i>
                                    </div>
                                    <h3 class="mb-0">@Model.Sum(p => p.Items.Count)</h3>
                                    <p class="text-muted mb-0">Total Medications</p>
                                </div>
                            </div>
                            <div class="col-md-3 mb-3">
                                <div class="stat-card text-center p-4 bg-light rounded shadow-sm">
                                    <div class="stat-icon mb-2">
                                        <i class="fas fa-redo-alt fa-3x text-warning"></i>
                                    </div>
                                    <h3 class="mb-0">@Model.Sum(p => p.Items.Sum(i => i.Repeats))</h3>
                                    <p class="text-muted mb-0">Total Repeats Available</p>
                                </div>
                            </div>
                            <div class="col-md-3 mb-3">
                                @{
                                    decimal grandTotal = 0;
                                    foreach (var p in Model)
                                    {
                                        decimal subtotal = p.Items.Sum(i => (i.Medication?.Price ?? 0) * i.Quantity);
                                        grandTotal += subtotal * 1.15m; // Include VAT
                                    }
                                }
                                <div class="stat-card text-center p-4 bg-success text-white rounded shadow-sm">
                                    <div class="stat-icon mb-2">
                                        <i class="fas fa-money-bill-wave fa-3x"></i>
                                    </div>
                                    <h3 class="mb-0">R @grandTotal.ToString("F2")</h3>
                                    <p class="mb-0">Total Amount Due (incl. VAT)</p>
                                </div>
                            </div>
                        </div>

                        <!-- Payment Notice -->
                        <div class="alert alert-warning mb-4">
                            <i class="fas fa-info-circle"></i> <strong>Payment Information:</strong>
                            Payment is due upon collection of medication at the pharmacy. All amounts shown include 15% VAT.
                        </div>

                        <!-- Orders List -->
                        @foreach (var prescription in Model)
                        {
                            <div class="order-card mb-4 border rounded shadow-sm">
                                <div class="order-header bg-light-green p-4">
                                    <div class="row align-items-center">
                                        <div class="col-md-8">
                                            <h4 class="mb-2 text-primary">
                                                <i class="fas fa-file-prescription"></i> Prescription #@prescription.Id
                                            </h4>
                                            <div class="order-meta">
                                                <span class="badge badge-info mr-2">
                                                    <i class="fas fa-calendar"></i> @prescription.PrescriptionDate.ToString("dd MMMM yyyy")
                                                </span>
                                                <span class="badge badge-secondary mr-2">
                                                    <i class="fas fa-user"></i> @prescription.PatientName
                                                </span>
                                                @if (prescription.Doctor != null)
                                                {
                                                    <span class="badge badge-success">
                                                        <i class="fas fa-user-md"></i> Dr. @prescription.Doctor.Name @prescription.Doctor.Surname
                                                    </span>
                                                }
                                            </div>
                                        </div>
                                        <div class="col-md-4 text-md-right mt-3 mt-md-0">
                                            <div class="order-stats">
                                                <div class="mb-2">
                                                    <strong>@prescription.Items.Count</strong> Medication(s)
                                                </div>
                                                <div>
                                                    <strong>@prescription.Items.Sum(i => i.Repeats)</strong> Repeats Available
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <div class="order-body p-4">
                                    <h5 class="text-primary mb-3">
                                        <i class="fas fa-pills"></i> Medications Ordered
                                    </h5>

                                    <div class="table-responsive">
                                        <table class="table table-hover">
                                            <thead class="thead-light">
                                                <tr>
                                                    <th><i class="fas fa-capsules"></i> Medication</th>
                                                    <th class="text-center"><i class="fas fa-sort-numeric-up"></i> Quantity</th>
                                                    <th class="text-right"><i class="fas fa-tag"></i> Price/Unit</th>
                                                    <th class="text-right"><i class="fas fa-calculator"></i> Subtotal</th>
                                                    <th><i class="fas fa-notes-medical"></i> Instructions</th>
                                                    <th class="text-center"><i class="fas fa-redo"></i> Repeats</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @{
                                                    decimal prescriptionSubtotal = 0;
                                                }
                                                @foreach (var item in prescription.Items)
                                                {
                                                    decimal itemTotal = (item.Medication?.Price ?? 0) * item.Quantity;
                                                    prescriptionSubtotal += itemTotal;
                                                    <tr>
                                                        <td>
                                                            <strong class="text-dark">@item.Medication?.Name</strong>
                                                            @if (item.Medication != null)
                                                            {
                                                                <br />
                                                                <small class="text-muted">
                                                                    @item.Medication.DosageForm - Schedule @item.Medication.Schedule
                                                                </small>
                                                            }
                                                        </td>
                                                        <td class="text-center align-middle">
                                                            <span class="badge badge-info badge-pill px-3 py-2">
                                                                @item.Quantity
                                                            </span>
                                                        </td>
                                                        <td class="text-right align-middle">
                                                            <strong>R @((item.Medication?.Price ?? 0).ToString("F2"))</strong>
                                                        </td>
                                                        <td class="text-right align-middle">
                                                            <strong class="text-success">R @itemTotal.ToString("F2")</strong>
                                                        </td>
                                                        <td class="align-middle">
                                                            <small>@(item.Instructions ?? "No specific instructions")</small>
                                                        </td>
                                                        <td class="text-center align-middle">
                                                            @if (item.Repeats > 0)
                                                            {
                                                                <span class="badge badge-success badge-pill px-3 py-2">
                                                                    @item.Repeats available
                                                                </span>
                                                            }
                                                            else
                                                            {
                                                                <span class="badge badge-secondary badge-pill px-3 py-2">
                                                                    None
                                                                </span>
                                                            }
                                                        </td>
                                                    </tr>
                                                }
                                                @{
                                                    decimal vat = prescriptionSubtotal * 0.15m;
                                                    decimal total = prescriptionSubtotal + vat;
                                                }
                                                <tr class="table-secondary font-weight-bold">
                                                    <td colspan="3" class="text-right">Subtotal:</td>
                                                    <td class="text-right">R @prescriptionSubtotal.ToString("F2")</td>
                                                    <td colspan="2"></td>
                                                </tr>
                                                <tr class="table-secondary font-weight-bold">
                                                    <td colspan="3" class="text-right">VAT (15%):</td>
                                                    <td class="text-right">R @vat.ToString("F2")</td>
                                                    <td colspan="2"></td>
                                                </tr>
                                                <tr class="table-success font-weight-bold" style="font-size: 1.1rem;">
                                                    <td colspan="3" class="text-right">
                                                        <i class="fas fa-money-bill-wave"></i> TOTAL AMOUNT DUE:
                                                    </td>
                                                    <td class="text-right text-success">R @total.ToString("F2")</td>
                                                    <td colspan="2"></td>
                                                </tr>
                                            </tbody>
                                        </table>
                                    </div>

                                    <!-- Action Buttons -->
                                    <div class="row mt-4">
                                        <div class="col-md-4 mb-2">
                                            <a href="@Url.Action("ViewPrescriptionDetails", new { id = prescription.Id })"
                                               class="btn btn-info btn-block">
                                                <i class="fas fa-eye"></i> View Details
                                            </a>
                                        </div>
                                        <div class="col-md-4 mb-2">
                                            @if (prescription.PrescriptionFileData != null && prescription.PrescriptionFileData.Length > 0)
                                            {
                                                <a href="@Url.Action("DownloadPrescription", new { id = prescription.Id })"
                                                   class="btn btn-primary btn-block">
                                                    <i class="fas fa-download"></i> Download PDF
                                                </a>
                                            }
                                        </div>
                                        <div class="col-md-4 mb-2">
                                            @if (prescription.Items.Any(i => i.Repeats > 0))
                                            {
                                                <a href="@Url.Action("ManageRepeats")"
                                                   class="btn btn-success btn-block">
                                                    <i class="fas fa-redo-alt"></i> Request Repeat
                                                </a>
                                            }
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }

                        <!-- Export/Print Options -->
                        <div class="text-center mt-5">
                            <a href="@Url.Action("GenerateReport")" class="btn btn-primary btn-lg px-5 shadow">
                                <i class="fas fa-file-pdf"></i> Generate PDF Report
                            </a>
                        </div>
                    }
                    else
                    {
                        <div class="empty-state text-center py-5">
                            <div class="mb-4">
                                <i class="fas fa-inbox fa-5x text-muted"></i>
                            </div>
                            <h3 class="text-muted mb-3">No Orders Found</h3>
                            <p class="lead text-muted mb-4">
                                You don't have any prescription orders yet.
                            </p>
                            <a href="@Url.Action("UploadPrescription")" class="btn btn-primary btn-lg px-5">
                                <i class="fas fa-upload"></i> Upload Prescription
                            </a>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .bg-gradient-primary {
        background: linear-gradient(135deg, #7bed9f 0%, #2ed573 100%);
    }

    .bg-light-green {
        background: linear-gradient(to right, #f0fdf4, #dcfce7);
        border-bottom: 3px solid #7bed9f;
    }

    .order-card {
        transition: all 0.3s ease;
        border: 2px solid rgba(123, 237, 159, 0.3);
    }

        .order-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 10px 25px rgba(46, 213, 115, 0.2) !important;
        }

    .stat-card {
        transition: all 0.3s ease;
        border: 2px solid rgba(123, 237, 159, 0.3);
    }

        .stat-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 10px 25px rgba(46, 213, 115, 0.2);
        }

        .stat-card h3 {
            color: #2ed573;
            font-weight: 700;
            font-size: 2.5rem;
        }

    .table {
        font-size: 1.05rem;
    }

        .table thead th {
            font-weight: 600;
            border-bottom: 2px solid #7bed9f;
            color: #2ed573;
        }

    .order-meta .badge {
        font-size: 0.95rem;
        padding: 0.5rem 0.75rem;
    }

    .order-stats {
        font-size: 1.1rem;
    }

    .btn-primary {
        background: linear-gradient(135deg, #7bed9f 0%, #2ed573 100%);
        border: none;
        font-weight: 600;
        transition: all 0.3s ease;
    }

        .btn-primary:hover {
            background: linear-gradient(135deg, #2ed573 0%, #1ea85a 100%);
            transform: translateY(-2px);
            box-shadow: 0 5px 15px rgba(46, 213, 115, 0.4);
        }

    .btn-success {
        background: linear-gradient(135deg, #7bed9f 0%, #2ed573 100%);
        border: none;
        font-weight: 600;
        transition: all 0.3s ease;
    }

        .btn-success:hover {
            background: linear-gradient(135deg, #2ed573 0%, #1ea85a 100%);
            transform: translateY(-2px);
            box-shadow: 0 5px 15px rgba(46, 213, 115, 0.4);
        }

    .btn-info {
        font-weight: 600;
        transition: all 0.3s ease;
    }

        .btn-info:hover {
            transform: translateY(-2px);
            box-shadow: 0 5px 15px rgba(23, 162, 184, 0.4);
        }

    .btn-outline-success {
        border: 2px solid #2ed573;
        color: #2ed573;
        font-weight: 600;
    }

        .btn-outline-success:hover {
            background: #2ed573;
            color: white;
        }

    .empty-state i {
        opacity: 0.3;
    }

    .card {
        border-radius: 15px;
    }

    .text-primary {
        color: #2ed573 !important;
    }

    .alert {
        font-size: 1.05rem;
        border-radius: 10px;
    }
</style>