@page
@model RegisterModel
@{
    ViewData["Title"] = "Register";
}

<div class="container-fluid mt-4 mb-5">
    <!-- Home Button -->
    <div class="row mb-3">
        <div class="col-12">
            <a href="/" class="btn btn-outline-success btn-lg">
                <i class="fas fa-home"></i> Back to Home
            </a>
        </div>
    </div>

    <div class="row justify-content-center">
        <div class="col-md-10 col-lg-8">
            <div class="card shadow-lg border-0">
                <div class="card-header bg-gradient-primary text-white text-center py-4">
                    <h1 class="display-4 mb-2"><i class="fas fa-user-plus"></i> Customer Registration</h1>
                    <p class="lead mb-0">Create your Ibhayi Pharmacy account</p>
                </div>
                <div class="card-body p-5">
                    <form id="registerForm" asp-route-returnUrl="@Model.ReturnUrl" method="post">
                        <!-- Show ALL validation errors -->
                        <div asp-validation-summary="All" class="alert alert-danger alert-dismissible fade show" role="alert">
                            <button type="button" class="close" data-dismiss="alert">&times;</button>
                        </div>

                        <!-- Personal Information -->
                        <div class="section-header mb-4">
                            <h3 class="text-primary"><i class="fas fa-user"></i> Personal Information</h3>
                            <hr class="section-line">
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-4">
                                <label asp-for="Input.Name" class="form-label-lg">First Name <span class="text-danger">*</span></label>
                                <input asp-for="Input.Name" class="form-control form-control-lg" placeholder="John" autocomplete="given-name" />
                                <span asp-validation-for="Input.Name" class="text-danger font-weight-bold"></span>
                            </div>
                            <div class="col-md-6 mb-4">
                                <label asp-for="Input.Surname" class="form-label-lg">Surname <span class="text-danger">*</span></label>
                                <input asp-for="Input.Surname" class="form-control form-control-lg" placeholder="Doe" autocomplete="family-name" />
                                <span asp-validation-for="Input.Surname" class="text-danger font-weight-bold"></span>
                            </div>
                        </div>

                        <div class="mb-4">
                            <label asp-for="Input.IdNumber" class="form-label-lg">ID Number <span class="text-danger">*</span></label>
                            <input asp-for="Input.IdNumber" class="form-control form-control-lg" placeholder="9901015800088"
                                   maxlength="13" />
                            <div class="form-text-lg mt-2">
                                <i class="fas fa-info-circle text-info"></i> 13-digit South African ID Number
                            </div>
                            <span asp-validation-for="Input.IdNumber" class="text-danger font-weight-bold"></span>
                        </div>

                        <!-- Contact Information -->
                        <div class="section-header mb-4 mt-5">
                            <h3 class="text-primary"><i class="fas fa-phone"></i> Contact Information</h3>
                            <hr class="section-line">
                        </div>

                        <div class="mb-4">
                            <label asp-for="Input.Cellphone" class="form-label-lg">Cellphone Number <span class="text-danger">*</span></label>
                            <input asp-for="Input.Cellphone" class="form-control form-control-lg" placeholder="0821234567"
                                   maxlength="10" autocomplete="tel" />
                            <div class="form-text-lg mt-2">
                                <i class="fas fa-info-circle text-info"></i> 10 digits starting with 0
                            </div>
                            <span asp-validation-for="Input.Cellphone" class="text-danger font-weight-bold"></span>
                        </div>

                        <div class="mb-4">
                            <label asp-for="Input.Email" class="form-label-lg">Email Address <span class="text-danger">*</span></label>
                            <input asp-for="Input.Email" class="form-control form-control-lg" placeholder="john.doe@example.com"
                                   autocomplete="username" />
                            <div class="form-text-lg mt-2">
                                <i class="fas fa-info-circle text-info"></i> This will be your username for login
                            </div>
                            <span asp-validation-for="Input.Email" class="text-danger font-weight-bold"></span>
                        </div>

                        <!-- Medical Information -->
                        <div class="section-header mb-4 mt-5">
                            <h3 class="text-primary"><i class="fas fa-allergies"></i> Medical Information</h3>
                            <hr class="section-line">
                        </div>

                        <div class="mb-4">
                            <label class="form-label-lg">Allergies to Active Ingredients</label>
                            <div class="alert alert-info">
                                <i class="fas fa-info-circle"></i> <strong>Select any active ingredients you're allergic to.</strong> This helps prevent allergic reactions.
                            </div>

                            <div class="allergy-selection-box p-4 border rounded">
                                <div class="row">
                                    <div class="col-md-4 mb-3">
                                        <div class="form-check form-check-lg">
                                            <input class="form-check-input allergy-checkbox" type="checkbox" value="Pylorazine" id="allergy1">
                                            <label class="form-check-label-lg" for="allergy1">Pylorazine</label>
                                        </div>
                                    </div>
                                    <div class="col-md-4 mb-3">
                                        <div class="form-check form-check-lg">
                                            <input class="form-check-input allergy-checkbox" type="checkbox" value="Vaspril" id="allergy2">
                                            <label class="form-check-label-lg" for="allergy2">Vaspril</label>
                                        </div>
                                    </div>
                                    <div class="col-md-4 mb-3">
                                        <div class="form-check form-check-lg">
                                            <input class="form-check-input allergy-checkbox" type="checkbox" value="Zentropine" id="allergy3">
                                            <label class="form-check-label-lg" for="allergy3">Zentropine</label>
                                        </div>
                                    </div>
                                    <div class="col-md-4 mb-3">
                                        <div class="form-check form-check-lg">
                                            <input class="form-check-input allergy-checkbox" type="checkbox" value="Histarelin" id="allergy4">
                                            <label class="form-check-label-lg" for="allergy4">Histarelin</label>
                                        </div>
                                    </div>
                                    <div class="col-md-4 mb-3">
                                        <div class="form-check form-check-lg">
                                            <input class="form-check-input allergy-checkbox" type="checkbox" value="Lorvexamine" id="allergy5">
                                            <label class="form-check-label-lg" for="allergy5">Lorvexamine</label>
                                        </div>
                                    </div>
                                    <div class="col-md-4 mb-3">
                                        <div class="form-check form-check-lg">
                                            <input class="form-check-input allergy-checkbox" type="checkbox" value="Aterolazine" id="allergy6">
                                            <label class="form-check-label-lg" for="allergy6">Aterolazine</label>
                                        </div>
                                    </div>
                                    <div class="col-md-4 mb-3">
                                        <div class="form-check form-check-lg">
                                            <input class="form-check-input allergy-checkbox" type="checkbox" value="Bronchomid" id="allergy7">
                                            <label class="form-check-label-lg" for="allergy7">Bronchomid</label>
                                        </div>
                                    </div>
                                    <div class="col-md-4 mb-3">
                                        <div class="form-check form-check-lg">
                                            <input class="form-check-input allergy-checkbox" type="checkbox" value="Glycetrol" id="allergy8">
                                            <label class="form-check-label-lg" for="allergy8">Glycetrol</label>
                                        </div>
                                    </div>
                                    <div class="col-md-4 mb-3">
                                        <div class="form-check form-check-lg">
                                            <input class="form-check-input allergy-checkbox" type="checkbox" value="Phospholax" id="allergy9">
                                            <label class="form-check-label-lg" for="allergy9">Phospholax</label>
                                        </div>
                                    </div>
                                    <div class="col-md-4 mb-3">
                                        <div class="form-check form-check-lg">
                                            <input class="form-check-input allergy-checkbox" type="checkbox" value="Nexorin" id="allergy10">
                                            <label class="form-check-label-lg" for="allergy10">Nexorin</label>
                                        </div>
                                    </div>
                                    <div class="col-md-4 mb-3">
                                        <div class="form-check form-check-lg">
                                            <input class="form-check-input allergy-checkbox" type="checkbox" value="Myvetrin" id="allergy11">
                                            <label class="form-check-label-lg" for="allergy11">Myvetrin</label>
                                        </div>
                                    </div>
                                    <div class="col-md-4 mb-3">
                                        <div class="form-check form-check-lg">
                                            <input class="form-check-input allergy-checkbox" type="checkbox" value="Veltraxin" id="allergy12">
                                            <label class="form-check-label-lg" for="allergy12">Veltraxin</label>
                                        </div>
                                    </div>
                                </div>
                                <div class="mt-3">
                                    <button type="button" class="btn btn-sm btn-outline-secondary" onclick="clearAllergies()">
                                        <i class="fas fa-times"></i> Clear All
                                    </button>
                                    <span class="ml-3 text-muted" id="allergyCount">No allergies selected</span>
                                </div>
                            </div>
                            <input type="hidden" asp-for="Input.Allergies" />
                        </div>

                        <!-- Account Security -->
                        <div class="section-header mb-4 mt-5">
                            <h3 class="text-primary"><i class="fas fa-lock"></i> Account Security</h3>
                            <hr class="section-line">
                        </div>

                        <div class="mb-4">
                            <label asp-for="Input.Password" class="form-label-lg">Password <span class="text-danger">*</span></label>
                            <div class="input-group input-group-lg">
                                <input asp-for="Input.Password" class="form-control" type="password"
                                       placeholder="Enter a strong password" autocomplete="new-password" id="passwordInput" />
                                <div class="input-group-append">
                                    <button class="btn btn-outline-secondary btn-lg" type="button" onclick="togglePassword('passwordInput', 'passwordIcon')">
                                        <i class="fas fa-eye" id="passwordIcon"></i>
                                    </button>
                                </div>
                            </div>
                            <div class="form-text-lg mt-2">
                                <i class="fas fa-info-circle text-info"></i> Must be at least 6 characters with uppercase, lowercase, number and special character
                            </div>
                            <span asp-validation-for="Input.Password" class="text-danger font-weight-bold"></span>
                        </div>

                        <div class="mb-4">
                            <label asp-for="Input.ConfirmPassword" class="form-label-lg">Confirm Password <span class="text-danger">*</span></label>
                            <div class="input-group input-group-lg">
                                <input asp-for="Input.ConfirmPassword" class="form-control" type="password"
                                       placeholder="Re-enter your password" autocomplete="new-password" id="confirmPasswordInput" />
                                <div class="input-group-append">
                                    <button class="btn btn-outline-secondary btn-lg" type="button" onclick="togglePassword('confirmPasswordInput', 'confirmPasswordIcon')">
                                        <i class="fas fa-eye" id="confirmPasswordIcon"></i>
                                    </button>
                                </div>
                            </div>
                            <span asp-validation-for="Input.ConfirmPassword" class="text-danger font-weight-bold"></span>
                        </div>

                        <!-- Terms and Conditions - FIXED -->
                        <div class="form-group mb-4 p-4 bg-light rounded">
                            <div class="form-check form-check-lg">
                                <input asp-for="Input.AgreeToTerms" class="form-check-input" type="checkbox" value="true" />
                                <input type="hidden" asp-for="Input.AgreeToTerms" value="false" />
                                <label asp-for="Input.AgreeToTerms" class="form-check-label-lg">
                                    I agree to the <a href="#" data-toggle="modal" data-target="#termsModal" onclick="event.preventDefault(); showTermsModal();" class="font-weight-bold">Terms and Conditions</a> <span class="text-danger">*</span>
                                </label>
                            </div>
                            <span asp-validation-for="Input.AgreeToTerms" class="text-danger font-weight-bold d-block mt-2"></span>
                        </div>

                        <!-- Submit Button -->
                        <div class="text-center mb-4">
                            <button id="registerSubmit" type="submit" class="btn btn-primary btn-lg px-5 py-3 shadow">
                                <i class="fas fa-user-plus"></i> Create Account
                            </button>
                        </div>

                        <hr class="my-4" />

                        <p class="text-center lead mb-0">
                            Already have an account?
                            <a asp-page="./Login" asp-route-returnUrl="@Model.ReturnUrl" class="font-weight-bold">Sign in here</a>
                        </p>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Terms and Conditions Modal -->
<div class="modal fade" id="termsModal" tabindex="-1" role="dialog">
    <div class="modal-dialog modal-lg modal-dialog-centered" role="document">
        <div class="modal-content">
            <div class="modal-header bg-gradient-primary text-white">
                <h4 class="modal-title"><i class="fas fa-file-contract"></i> Terms and Conditions</h4>
                <button type="button" class="close text-white" data-dismiss="modal">
                    <span>&times;</span>
                </button>
            </div>
            <div class="modal-body" style="font-size: 1.1rem;">
                <h5 class="text-primary">1. Account Registration</h5>
                <p>By creating an account, you agree to provide accurate and complete information. You are responsible for maintaining the confidentiality of your account credentials.</p>

                <h5 class="text-primary">2. Prescription Services</h5>
                <p>Ibhayi Pharmacy provides prescription dispensing services. All prescriptions must be valid and issued by a registered healthcare professional.</p>

                <h5 class="text-primary">3. Medical Information</h5>
                <p>The allergy information you provide will be used to alert pharmacists of potential allergic reactions. Please ensure this information is accurate and up-to-date.</p>

                <h5 class="text-primary">4. Privacy Policy</h5>
                <p>Your personal and medical information will be kept confidential and used only for the purposes of providing pharmaceutical services.</p>

                <h5 class="text-primary">5. Payment</h5>
                <p>Payment is due upon collection of medication. Prices are subject to change.</p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary btn-lg" data-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        // Wait for DOM to be fully loaded
        document.addEventListener('DOMContentLoaded', function() {
            console.log('Registration page loaded');

            // Initialize allergy functionality
            initializeAllergies();

            // Initialize input validation
            initializeInputValidation();

            // Initialize form submission handler
            initializeFormSubmission();
        });

        // Show terms modal
        function showTermsModal() {
            $('#termsModal').modal('show');
        }

        // Toggle password visibility
        function togglePassword(inputId, iconId) {
            const input = document.getElementById(inputId);
            const icon = document.getElementById(iconId);

            if (input && icon) {
                if (input.type === 'password') {
                    input.type = 'text';
                    icon.classList.remove('fa-eye');
                    icon.classList.add('fa-eye-slash');
                } else {
                    input.type = 'password';
                    icon.classList.remove('fa-eye-slash');
                    icon.classList.add('fa-eye');
                }
            }
        }

        // Initialize allergy selection
        function initializeAllergies() {
            document.querySelectorAll('.allergy-checkbox').forEach(checkbox => {
                checkbox.addEventListener('change', updateAllergies);
            });
            updateAllergies(); // Initial update
        }

        // Update allergies hidden field
        function updateAllergies() {
            const selected = [];
            document.querySelectorAll('.allergy-checkbox:checked').forEach(cb => {
                selected.push(cb.value);
            });

            // Get the hidden input using the correct generated name
            const allergiesInput = document.querySelector('input[name="Input.Allergies"]');
            if (allergiesInput) {
                allergiesInput.value = selected.join(', ');
            }

            const count = selected.length;
            const countText = count === 0 ? 'No allergies selected' :
                             count === 1 ? '1 allergy selected' :
                             `${count} allergies selected`;

            const countElement = document.getElementById('allergyCount');
            if (countElement) {
                countElement.textContent = countText;
            }
        }

        // Clear all allergies
        function clearAllergies() {
            document.querySelectorAll('.allergy-checkbox').forEach(cb => {
                cb.checked = false;
            });
            updateAllergies();
        }

        // Initialize input validation
        function initializeInputValidation() {
            // Real-time ID Number validation
            const idInput = document.querySelector('input[name="Input.IdNumber"]');
            if (idInput) {
                idInput.addEventListener('input', function(e) {
                    e.target.value = e.target.value.replace(/\D/g, '').substring(0, 13);
                });
            }

            // Real-time Cellphone validation
            const phoneInput = document.querySelector('input[name="Input.Cellphone"]');
            if (phoneInput) {
                phoneInput.addEventListener('input', function(e) {
                    e.target.value = e.target.value.replace(/\D/g, '').substring(0, 10);
                });
            }
        }

        // Initialize form submission - CRITICAL FIX
        function initializeFormSubmission() {
            const form = document.getElementById('registerForm');
            const submitButton = document.getElementById('registerSubmit');

            if (form) {
                form.addEventListener('submit', function(e) {
                    // DON'T prevent default - let the form submit naturally
                    console.log('Form submitting...');

                    // Just disable the button and show loading state
                    if (submitButton) {
                        submitButton.disabled = true;
                        submitButton.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Creating Account...';
                    }

                    // Form will submit naturally after this
                });
            }
        }
    </script>
}

<style>
    body {
        font-size: 1.1rem;
        background: linear-gradient(to bottom, #f0fdf4 0%, #ffffff 100%);
        min-height: 100vh;
    }

    .bg-gradient-primary {
        background: linear-gradient(135deg, #7bed9f 0%, #2ed573 100%);
    }

    .card {
        border-radius: 15px;
        border: 2px solid rgba(123, 237, 159, 0.3);
    }

    .form-label-lg {
        font-size: 1.25rem;
        font-weight: 600;
        color: #2c3e50;
        margin-bottom: 0.75rem;
    }

    .form-check-label-lg {
        font-size: 1.15rem;
        font-weight: 500;
        cursor: pointer;
    }

    .form-control-lg {
        font-size: 1.2rem;
        padding: 0.75rem 1rem;
        border: 2px solid #dee2e6;
    }

        .form-control-lg:focus {
            border-color: #7bed9f;
            box-shadow: 0 0 0 0.25rem rgba(123, 237, 159, 0.25);
        }

    .form-text-lg {
        font-size: 1.05rem;
        color: #6c757d;
    }

    .form-check-input {
        width: 1.5rem;
        height: 1.5rem;
        margin-top: 0.15rem;
        cursor: pointer;
    }

    .form-check-lg {
        padding-left: 2.25rem;
    }

    .allergy-selection-box {
        background: #f8f9fa;
        max-height: 400px;
        overflow-y: auto;
    }

    .section-header h3 {
        font-size: 1.75rem;
        font-weight: 700;
    }

    .section-line {
        border-top: 3px solid #7bed9f;
        width: 100px;
        margin: 0.5rem 0 0 0;
    }

    .btn-primary {
        background: linear-gradient(135deg, #7bed9f 0%, #2ed573 100%);
        border: none;
        font-size: 1.3rem;
        font-weight: 600;
        transition: all 0.3s ease;
    }

        .btn-primary:hover:not(:disabled) {
            background: linear-gradient(135deg, #2ed573 0%, #1ea85a 100%);
            transform: translateY(-2px);
            box-shadow: 0 8px 20px rgba(46, 213, 115, 0.4);
        }

        .btn-primary:disabled {
            background: #6c757d;
            transform: none;
            cursor: not-allowed;
            opacity: 0.6;
        }

    .btn-outline-success {
        border: 2px solid #2ed573;
        color: #2ed573;
        font-weight: 600;
    }

        .btn-outline-success:hover {
            background: #2ed573;
            color: white;
        }

    .text-danger {
        font-size: 1.1rem;
    }

    .alert {
        font-size: 1.1rem;
    }

    .display-4 {
        font-size: 2.5rem;
    }

    .lead {
        font-size: 1.3rem;
    }

    @@media (max-width: 768px) {
        .form-label-lg {
            font-size: 1.1rem;
        }

        .form-control-lg {
            font-size: 1.1rem;
        }

        .display-4 {
            font-size: 2rem;
        }
    }
</style>