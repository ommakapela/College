@page
@model LogoutModel
@{
    ViewData["Title"] = "Log out";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Ibhayi Pharmacy</title>
    <link href="~/https://fonts.googleapis.com/css2?family=Nunito:wght@400;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/style.css" />
</head>

<body>
    <div class="site-wrap">
        <div class="container mt-5 mb-5">
            <div class="row justify-content-center">
                <div class="col-md-8">
                    <div class="card shadow-lg p-4 text-center">
                        <h2 class="text-primary mb-4">@ViewData["Title"]</h2>

                        @if (User.Identity?.IsAuthenticated ?? false)
                        {
                            <p class="mb-4">Are you sure you want to log out?</p>
                            <form asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Page("/", new { area = "" })" method="post">
                                <button type="submit" class="btn btn-danger w-100">Log Out</button>
                            </form>
                        }
                        else
                        {
                            <p class="text-success fs-5">You have successfully logged out of the application.</p>
                            <a href="~/" class="btn btn-outline-primary mt-3">← Return to Home</a>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script src="~/js/jquery-3.3.1.min.js"></script>
    <script src="~/js/bootstrap.bundle.min.js"></script>
</body>

</html>
